  "implementation_steps": [
    "Define shared lifecycle events for tool start, tool complete, task created/completed, cron fire, worktree enter/exit, team create/delete, and MCP resource changes.",
    "Add rollback/abort semantics for hooks that TS treats as blocking.",
    "Persist enough state for session resume and compaction for all tools that currently keep Go-only in-memory state.",
    "Normalize notification and mailbox side effects through shared services."
  ],
  "acceptance_criteria": [
    "Hook-blocked tool operations do not leave partial state.",
    "Resume and compaction preserve active tool state where TS does.",
    "Notifications/mailbox/task updates are emitted through one tested path."
  ],
  "verification": [
    "go test ./hooks ./session ./compact ./tools -run \"Hook|Lifecycle|Resume|Compaction|Notification|Mailbox|State\" -count=1"
  ],
  "risks": [
    "State migration can strand existing local files; include compatibility readers for current Go formats."
  ],
  "non_goals": [
    "Do not implement remote production services; provide compatible interfaces/stubs where needed."
  ],
  "notes_for_assignee": "Build the shared surface narrowly and prove it with one or two migrated tools before broad rollout."
