{
  "schema_version": "1",
  "id": "basic_text",
  "title": "returns assistant text and ends the loop",
  "status": "active",
  "updated_at": "2026-07-10",
  "source_tests": ["loop/integration_test.go:TestIntegrationMultiTurnConversation"],
  "coverage_tags": ["core.basic_loop", "stream.text_delta", "events.text", "terminal.end_turn"],
  "parity_tasks": ["task_16"],
  "input": {
    "user_message": "hi",
    "max_turns": 10,
    "max_tokens": 1024
  },
  "tools": [
    {"name": "Echo", "kind": "echo", "echo_prefix": "echo: "}
  ],
  "turns": [
    {
      "events": [
        {"type": "message_start", "message": {"role": "assistant"}},
        {"type": "content_block_start", "index": 0, "content_block": {"type": "text"}},
        {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "Hello!"}},
        {"type": "content_block_stop", "index": 0},
        {"type": "message_delta", "stop_reason": "end_turn"},
        {"type": "message_stop"}
      ]
    }
  ],
  "expected": {
    "terminal_reason": "end_turn",
    "final_text": "Hello!",
    "message_count": 2,
    "provider_call_count": 1,
    "events": [
      {"type": "text", "text": "Hello!"}
    ]
  }
}
