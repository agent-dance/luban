{
  "schema_version": "1",
  "id": "max_turns_exceeded",
  "title": "returns a typed max turns error when tool calls never reach a terminal answer",
  "status": "active",
  "updated_at": "2026-07-10",
  "source_tests": ["loop/integration_test.go:TestIntegrationMaxTurnsExceeded"],
  "coverage_tags": ["core.max_turns", "errors.max_turns", "events.max_turns_reached"],
  "parity_tasks": ["task_16", "task_14"],
  "input": {
    "user_message": "infinite loop",
    "max_turns": 3,
    "max_tokens": 1024
  },
  "tools": [
    {"name": "Echo", "kind": "echo", "echo_prefix": "echo: "}
  ],
  "turns": [
    {
      "events": [
        {"type": "message_start", "message": {"role": "assistant"}},
        {"type": "content_block_start", "index": 0, "content_block": {"type": "tool_use", "id": "call_loop_1", "name": "Echo"}},
        {"type": "content_block_delta", "index": 0, "delta": {"type": "input_json_delta", "partial_json": "{\"text\":\"loop\"}"}},
        {"type": "content_block_stop", "index": 0},
        {"type": "message_delta", "stop_reason": "tool_use"},
        {"type": "message_stop"}
      ]
    },
    {
      "events": [
        {"type": "message_start", "message": {"role": "assistant"}},
        {"type": "content_block_start", "index": 0, "content_block": {"type": "tool_use", "id": "call_loop_2", "name": "Echo"}},
        {"type": "content_block_delta", "index": 0, "delta": {"type": "input_json_delta", "partial_json": "{\"text\":\"loop\"}"}},
        {"type": "content_block_stop", "index": 0},
        {"type": "message_delta", "stop_reason": "tool_use"},
        {"type": "message_stop"}
      ]
    },
    {
      "events": [
        {"type": "message_start", "message": {"role": "assistant"}},
        {"type": "content_block_start", "index": 0, "content_block": {"type": "tool_use", "id": "call_loop_3", "name": "Echo"}},
        {"type": "content_block_delta", "index": 0, "delta": {"type": "input_json_delta", "partial_json": "{\"text\":\"loop\"}"}},
        {"type": "content_block_stop", "index": 0},
        {"type": "message_delta", "stop_reason": "tool_use"},
        {"type": "message_stop"}
      ]
    },
    {
      "events": [
        {"type": "message_start", "message": {"role": "assistant"}},
        {"type": "content_block_start", "index": 0, "content_block": {"type": "tool_use", "id": "call_loop_4", "name": "Echo"}},
        {"type": "content_block_delta", "index": 0, "delta": {"type": "input_json_delta", "partial_json": "{\"text\":\"loop\"}"}},
        {"type": "content_block_stop", "index": 0},
        {"type": "message_delta", "stop_reason": "tool_use"},
        {"type": "message_stop"}
      ]
    }
  ],
  "expected": {
    "terminal_reason": "max_turns_exceeded",
    "error_contains": "max turns (3) exceeded",
    "provider_call_count": 3,
    "events": [
      {"type": "tool_use", "tool_name": "Echo"},
      {"type": "tool_result", "tool_result_contains": "echo: loop"},
      {"type": "max_turns_reached"}
    ]
  }
}
