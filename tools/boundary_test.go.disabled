package tools

import (
	"context"
	"os"
	"path/filepath"
	"strings"
	"testing"
)

func TestFileEditNonexistentFile(t *testing.T) {
	tool := &FileEditTool{}
	result, _ := tool.Execute(context.Background(), map[string]any{
		"file_path":  "/nonexistent/path.txt",
		"old_string": "x",
		"new_string": "y",
	})
	if !result.IsError {
		t.Error("expected error for nonexistent file")
	}
}

func TestFileWriteMissingContentParam(t *testing.T) {
	tool := &FileWriteTool{}
	result, _ := tool.Execute(context.Background(), map[string]any{"file_path": "/tmp/test.txt"})
	if !result.IsError {
		t.Error("expected error for missing content")
	}
}

func TestFileWriteMissingFilePathParam(t *testing.T) {
	tool := &FileWriteTool{}
	result, _ := tool.Execute(context.Background(), map[string]any{"content": "hello"})
	if !result.IsError {
		t.Error("expected error for missing file_path")
	}
}

func TestFileReadEmptyFile(t *testing.T) {
	dir := t.TempDir()
	fp := filepath.Join(dir, "empty.txt")
	os.WriteFile(fp, []byte(""), 0644)

	tool := &FileReadTool{}
	result, _ := tool.Execute(context.Background(), map[string]any{"file_path": fp})
	if result.IsError {
		t.Fatalf("unexpected error: %s", result.Content)
	}
	// Empty file has one empty line
	if !strings.Contains(result.Content, "1\t") {
		t.Errorf("expected line number in output, got '%s'", result.Content)
	}
}

func TestFileReadOffsetBeyondEOF(t *testing.T) {
	dir := t.TempDir()
	fp := filepath.Join(dir, "short.txt")
	os.WriteFile(fp, []byte("a\nb\nc\n"), 0644)

	tool := &FileReadTool{}
	result, _ := tool.Execute(context.Background(), map[string]any{
		"file_path": fp,
		"offset":    float64(999),
	})
	if !result.IsError {
		t.Error("expected IsError=true for offset beyond EOF")
	}
}

func TestFileReadWriteUnicode(t *testing.T) {
	dir := t.TempDir()
	fp := filepath.Join(dir, "unicode.txt")
	content := "你好世界 🌍\nこんにちは\n🎉 émojis & ünîcödé"

	writeTool := &FileWriteTool{}
	_, err := writeTool.Execute(context.Background(), map[string]any{"file_path": fp, "content": content})
	if err != nil {
		t.Fatal(err)
	}

	readTool := &FileReadTool{}
	result, _ := readTool.Execute(context.Background(), map[string]any{"file_path": fp})
	if !strings.Contains(result.Content, "你好世界") {
		t.Error("expected Chinese characters preserved")
	}
	if !strings.Contains(result.Content, "🌍") {
		t.Error("expected emoji preserved")
	}
}

func TestBashToolStderrOutput(t *testing.T) {
	tool := &BashTool{}
	result, _ := tool.Execute(context.Background(), map[string]any{"command": "echo error >&2"})
	if !strings.Contains(result.Content, "error") {
		t.Errorf("expected stderr in output, got '%s'", result.Content)
	}
}

func TestGrepToolInvalidRegex(t *testing.T) {
	tool := &GrepTool{}
	result, _ := tool.Execute(context.Background(), map[string]any{
		"pattern": "[invalid",
		"path":    "/tmp",
	})
	if !result.IsError {
		t.Error("expected error for invalid regex")
	}
}

func TestGrepToolOnSingleFile(t *testing.T) {
	dir := t.TempDir()
	fp := filepath.Join(dir, "single.txt")
	os.WriteFile(fp, []byte("findme\nnope\n"), 0644)

	tool := &GrepTool{}
	result, _ := tool.Execute(context.Background(), map[string]any{
		"pattern": "findme",
		"path":    fp,
	})
	if !strings.Contains(result.Content, "single.txt") {
		t.Errorf("expected file in output, got '%s'", result.Content)
	}
}

func TestGlobToolHiddenDirsSkipped(t *testing.T) {
	dir := t.TempDir()
	hiddenDir := filepath.Join(dir, ".hidden")
	os.MkdirAll(hiddenDir, 0755)
	os.WriteFile(filepath.Join(hiddenDir, "secret.go"), []byte("x"), 0644)
	os.WriteFile(filepath.Join(dir, "visible.go"), []byte("x"), 0644)

	tool := &GlobTool{}
	result, _ := tool.Execute(context.Background(), map[string]any{
		"pattern": "**/*.go",
		"path":    dir,
	})
	if strings.Contains(result.Content, "secret.go") {
		t.Error("hidden dir files should be skipped")
	}
	if !strings.Contains(result.Content, "visible.go") {
		t.Error("expected visible.go in results")
	}
}

func TestGlobToolMissingPattern(t *testing.T) {
	tool := &GlobTool{}
	result, _ := tool.Execute(context.Background(), map[string]any{})
	if !result.IsError {
		t.Error("expected error for missing pattern")
	}
}
