{
  "name": "todo-write-state-transition",
  "tool": "TodoWrite",
  "category": "stateful",
  "ts_reference": "../src/tools/TodoWriteTool/TodoWriteTool.ts:65-113",
  "ts_behavior": "TodoWrite returns the pre-update list as oldTodos, the submitted list as newTodos, persists the status transition, and exposes only the mapped success text to the model.",
  "runtime": {
    "interactive": false
  },
  "setup": {
    "todos": [
      {
        "content": "Verify dispatcher",
        "status": "pending",
        "activeForm": "Verifying dispatcher"
      }
    ]
  },
  "input": {
    "todos": [
      {
        "content": "Verify dispatcher",
        "status": "in_progress",
        "activeForm": "Verifying dispatcher"
      }
    ]
  },
  "expected_enabled": true,
  "permission": {
    "behavior": "allow"
  },
  "expected_model_text": "Todos have been modified successfully. Ensure that you continue to use the todo list to track your progress. Please proceed with the current tasks if applicable",
  "expected_typed_data_json": {
    "oldTodos": [
      {
        "content": "Verify dispatcher",
        "status": "pending",
        "activeForm": "Verifying dispatcher"
      }
    ],
    "newTodos": [
      {
        "content": "Verify dispatcher",
        "status": "in_progress",
        "activeForm": "Verifying dispatcher"
      }
    ]
  },
  "expected_state": {
    "todo_count": 1
  }
}
