{
  "name": "todo-write-typed-data-and-store",
  "tool": "TodoWrite",
  "category": "mutating",
  "ts_reference": "../src/tools/TodoWriteTool/TodoWriteTool.ts:52-113",
  "ts_behavior": "When task-v2 is disabled, TodoWrite is enabled without a permission prompt, persists the submitted list, returns oldTodos/newTodos typed data, and maps it to the fixed success text.",
  "runtime": {
    "interactive": false
  },
  "input": {
    "todos": [
      {
        "content": "Draft parity harness",
        "status": "in_progress",
        "activeForm": "Drafting parity harness"
      },
      {
        "content": "Run golden tests",
        "status": "pending",
        "activeForm": "Running golden tests"
      }
    ]
  },
  "permission": {
    "behavior": "allow"
  },
  "expected_enabled": true,
  "expected_model_text": "Todos have been modified successfully. Ensure that you continue to use the todo list to track your progress. Please proceed with the current tasks if applicable",
  "expected_typed_data_json": {
    "oldTodos": [],
    "newTodos": [
      {
        "content": "Draft parity harness",
        "status": "in_progress",
        "activeForm": "Drafting parity harness"
      },
      {
        "content": "Run golden tests",
        "status": "pending",
        "activeForm": "Running golden tests"
      }
    ]
  },
  "expected_state": {
    "todo_count": 2
  }
}
