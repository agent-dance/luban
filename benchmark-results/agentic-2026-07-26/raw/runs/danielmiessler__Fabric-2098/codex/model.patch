+func TestSendFallsBackToStreamEventsWhenCompletedResponseHasNoOutput(t *testing.T) {
+	tests := []struct {
+		name       string
+		events     []map[string]any
+		wantOutput string
+	}{
+		{
+			name: "text deltas",
+			events: []map[string]any{
+				{
+					"type":  string(constant.ResponseOutputTextDelta("").Default()),
+					"delta": "hello from deltas",
+				},
+				{
+					"type": "response.completed",
+					"response": map[string]any{
+						"output": []any{},
+					},
+				},
+			},
+			wantOutput: "hello from deltas",
+		},
+		{
+			name: "text done",
+			events: []map[string]any{
+				{
+					"type": string(constant.ResponseOutputTextDone("").Default()),
+					"text": "hello from done",
+				},
+				{
+					"type": "response.completed",
+					"response": map[string]any{
+						"output": []any{},
+					},
+				},
+			},
+			wantOutput: "hello from done",
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			apiServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.URL.Path != "/responses" {
+					http.NotFound(w, r)
+					return
+				}
+
+				w.Header().Set("Content-Type", "text/event-stream")
+				flusher, ok := w.(http.Flusher)
+				if !ok {
+					t.Fatalf("response writer does not implement http.Flusher")
+				}
+				for _, event := range tc.events {
+					fmt.Fprintf(w, "data: %s\n\n", marshalJSON(t, event))
+					flusher.Flush()
+				}
+				fmt.Fprint(w, "data: [DONE]\n\n")
+			}))
+			defer apiServer.Close()
+
+			client := newConfiguredTestClient(t, apiServer.URL, "acct_fallback", testJWT("acct_fallback", time.Now().Add(time.Hour)))
+
+			message, err := client.Send(context.Background(), []*chat.ChatCompletionMessage{
+				{Role: chat.ChatMessageRoleUser, Content: "Hello"},
+			}, &domain.ChatOptions{Model: "gpt-5.4"})
+			if err != nil {
+				t.Fatalf("Send() error = %v", err)
+			}
+			if message != tc.wantOutput {
+				t.Fatalf("Send() = %q, want %q", message, tc.wantOutput)
+			}
+		})
+	}
+}
