+func TestOptionsUnmarshalCustomResourceConfigFile(t *testing.T) {
+	opts := NewOptions()
+	config := []byte("custom_resource_config_file: custom-resource-config.yaml\n")
+
+	if err := yaml.Unmarshal(config, opts); err != nil {
+		t.Fatalf("unexpected error unmarshalling options: %v", err)
+	}
+	if want := "custom-resource-config.yaml"; opts.CustomResourceConfigFile != want {
+		t.Errorf("CustomResourceConfigFile = %q, want %q", opts.CustomResourceConfigFile, want)
+	}
