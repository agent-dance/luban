+TEST_F(BuildTest, DyndepLoadUpdatesEarlierDepfileInput) {
+  // A depfile input may be visited before an order-only input loads the
+  // dyndep file that reveals its producing edge.  Verify that the dependent
+  // is made dirty in the same scan as the producing edge.
+  ASSERT_NO_FATAL_FAILURE(AssertParse(&state_,
+"rule touch\n"
+"  command = touch $out\n"
+"rule with_depfile\n"
+"  command = touch $out\n"
+"  depfile = $out.d\n"
+"build stamp: touch trigger || dd\n"
+"  dyndep = dd\n"
+"build copy: with_depfile || stamp\n"
+));
+  fs_.Create("dd",
+"ninja_dyndep_version = 1\n"
+"build stamp | other: dyndep\n"
+);
+  fs_.Create("stamp", "");
+  fs_.Create("other", "");
+  fs_.Create("copy", "");
+  fs_.Create("copy.d", "copy: other\n");
+  fs_.Tick();
+  fs_.Create("trigger", "");
+
+  string err;
+  EXPECT_TRUE(builder_.AddTarget("copy", &err));
+  ASSERT_EQ("", err);
+  EXPECT_EQ(builder_.Build(&err), ExitSuccess);
+  EXPECT_EQ("", err);
+  EXPECT_EQ(std::vector<std::string>({ "touch stamp", "touch copy" }),
+            command_runner_.commands_ran_);
+  EXPECT_TRUE(builder_.AlreadyUpToDate());
+}
