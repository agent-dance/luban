+TEST_F(BuildTest, DyndepReadyOutputUsedByDepfile) {
+  // A depfile input may initially look like a source file and then become a
+  // generated file when a later order-only input loads its dyndep file.  If
+  // the generating edge is dirty, the depfile consumer must be dirty too.
+  ASSERT_NO_FATAL_FAILURE(AssertParse(&state_,
+"rule touch\n"
+"  command = touch $out\n"
+"build stamp: touch in || dd\n"
+"  dyndep = dd\n"
+"build copy: touch || stamp\n"
+"  depfile = copy.d\n"
+  ));
+  fs_.Create("dd",
+"ninja_dyndep_version = 1\n"
+"build stamp | other: dyndep\n"
+  );
+  fs_.Create("stamp", "");
+  fs_.Create("other", "");
+  fs_.Create("copy", "");
+  fs_.Create("copy.d", "copy: other\n");
+  fs_.Tick();
+  fs_.Create("in", "");
+
+  string err;
+  EXPECT_TRUE(builder_.AddTarget("copy", &err));
+  ASSERT_EQ("", err);
+  EXPECT_EQ(builder_.Build(&err), ExitSuccess);
+  EXPECT_EQ("", err);
+  EXPECT_EQ(std::vector<std::string>({"touch stamp", "touch copy"}),
+            command_runner_.commands_ran_);
+}
+
+TEST_F(BuildTest, DyndepReadyOutputUsedByDepfileFromOtherEdge) {
+  // The edge that produces the depfile input may not have been reachable
+  // until another edge loads their shared dyndep file.
+  ASSERT_NO_FATAL_FAILURE(AssertParse(&state_,
+"rule touch\n"
+"  command = touch $out\n"
+"build producer: touch in || dd\n"
+"  dyndep = dd\n"
+"build trigger: touch || dd\n"
+"  dyndep = dd\n"
+"build copy: touch || trigger\n"
+"  depfile = copy.d\n"
+  ));
+  fs_.Create("dd",
+"ninja_dyndep_version = 1\n"
+"build producer | other: dyndep\n"
+"build trigger: dyndep\n"
+  );
+  fs_.Create("producer", "");
+  fs_.Create("other", "");
+  fs_.Create("trigger", "");
+  fs_.Create("copy", "");
+  fs_.Create("copy.d", "copy: other\n");
+  fs_.Tick();
+  fs_.Create("in", "");
+
+  string err;
+  EXPECT_TRUE(builder_.AddTarget("copy", &err));
+  ASSERT_EQ("", err);
+  EXPECT_EQ(builder_.Build(&err), ExitSuccess);
+  EXPECT_EQ("", err);
+  EXPECT_EQ(std::vector<std::string>({"touch producer", "touch copy"}),
+            command_runner_.commands_ran_);
+}
+
