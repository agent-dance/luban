+
+func TestDotStarIgnoreDoesNotSkipTraversalRoot(t *testing.T) {
+	tempDir := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, ".gitignore"), []byte(".*\n"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, ".hidden"), []byte("hidden"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, "example.txt"), []byte("test"), 0o644))
+	require.NoError(t, os.Mkdir(filepath.Join(tempDir, "src"), 0o755))
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, "src", "main.go"), []byte("package main"), 0o644))
+
+	files, truncated, err := ListDirectory(tempDir, nil, 0)
+	require.NoError(t, err)
+	require.False(t, truncated)
+	require.Contains(t, files, filepath.Join(tempDir, "example.txt"))
+	require.Contains(t, files, filepath.Join(tempDir, "src")+string(filepath.Separator))
+	require.Contains(t, files, filepath.Join(tempDir, "src", "main.go"))
+	require.NotContains(t, files, filepath.Join(tempDir, ".hidden"))
+
+	matches, truncated, err := GlobWithDoubleStar("**", tempDir, 0)
+	require.NoError(t, err)
+	require.False(t, truncated)
+	require.Contains(t, matches, filepath.Join(tempDir, "example.txt"))
+	require.Contains(t, matches, filepath.Join(tempDir, "src", "main.go"))
+	require.NotContains(t, matches, filepath.Join(tempDir, ".hidden"))
+}
