 import (
 	"os"
+	"path/filepath"
 	"testing"
 
 	"github.com/stretchr/testify/require"
 )
 
+func TestDotStarIgnoreDoesNotSkipTraversalRoot(t *testing.T) {
+	tempDir := t.TempDir()
+	examplePath := filepath.Join(tempDir, "example.txt")
+	anotherPath := filepath.Join(tempDir, "another.go")
+
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, ".gitignore"), []byte(".*\n"), 0o644))
+	require.NoError(t, os.WriteFile(examplePath, []byte("test content"), 0o644))
+	require.NoError(t, os.WriteFile(anotherPath, []byte("more content"), 0o644))
+
+	files, truncated, err := ListDirectory(tempDir, nil, 0)
+	require.NoError(t, err)
+	require.False(t, truncated)
+	require.ElementsMatch(t, []string{examplePath, anotherPath}, files)
+
+	matches, truncated, err := GlobWithDoubleStar("example.txt", tempDir, 0)
+	require.NoError(t, err)
+	require.False(t, truncated)
+	require.Equal(t, []string{examplePath}, matches)
+}
