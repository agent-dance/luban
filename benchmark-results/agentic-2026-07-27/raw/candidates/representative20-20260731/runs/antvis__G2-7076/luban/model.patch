+function createChannelValueOf(views, channelName) {
+  const channelValues = new Map();
+  for (const view of Array.isArray(views) ? views : [views]) {
+    for (const [mark, state] of view.markState) {
+      const channel = state.channels.find(({ name }) => name === channelName);
+      if (!channel) continue;
+      const channelValue = channel.values.find(
+        ({ name }) => name === channelName,
+      );
+      if (!channelValue) continue;
+      if (!channelValues.has(view.key)) channelValues.set(view.key, new Map());
+      channelValues.get(view.key).set(mark.key, channelValue.value);
+    }
+  }
+  return (element, index) =>
+    channelValues
+      .get(element.__data__.viewKey)
+      ?.get(element.__data__.markKey)?.[index];
+}
