 import { Fib, Fib2, Fib3, shutdownRuntime } from '../index.cjs'
 
+type IteratorWithHelpers<T> = Iterator<T> & {
+  [Symbol.iterator](): IteratorWithHelpers<T>
+  take(limit: number): { toArray(): T[] }
+}
+
 test.after(() => {
   shutdownRuntime()
 })
@@ -58,4 +63,21 @@ for (const [index, factory] of [
       done: true,
     })
   })
+
+  test(`should inherit Iterator helpers #${index}`, (t) => {
+    const iteratorConstructor = (
+      globalThis as typeof globalThis & {
+        Iterator?: Function & { prototype: object }
+      }
+    ).Iterator
+    if (typeof iteratorConstructor !== 'function') {
+      t.pass()
+      return
+    }
+
+    const iterator = factory()[Symbol.iterator]() as IteratorWithHelpers<number>
+    t.true(iteratorConstructor.prototype.isPrototypeOf(iterator))
+    t.is(iterator[Symbol.iterator](), iterator)
+    t.deepEqual(iterator.take(5).toArray(), [1, 1, 2, 3, 5])
+  })
 }
