+unsafe fn create_generator_object(env: sys::napi_env) -> sys::napi_value {
+  let mut global = ptr::null_mut();
+  check_status_or_throw!(
+    env,
+    unsafe { sys::napi_get_global(env, &mut global) },
+    "Get global object failed",
+  );
+
+  // Iterator helpers are inherited from Iterator.prototype. Older runtimes do
+  // not expose the Iterator constructor, so retain the plain object fallback.
+  let mut has_iterator = false;
+  check_status_or_throw!(
+    env,
+    unsafe {
+      sys::napi_has_named_property(env, global, c"Iterator".as_ptr().cast(), &mut has_iterator)
+    },
+    "Check global Iterator failed",
+  );
+
+  if has_iterator {
+    let mut iterator_constructor = ptr::null_mut();
+    check_status_or_throw!(
+      env,
+      unsafe {
+        sys::napi_get_named_property(
+          env,
+          global,
+          c"Iterator".as_ptr().cast(),
+          &mut iterator_constructor,
+        )
+      },
+      "Get global Iterator failed",
+    );
+    let mut iterator_prototype = ptr::null_mut();
+    check_status_or_throw!(
+      env,
+      unsafe {
+        sys::napi_get_named_property(
+          env,
+          iterator_constructor,
+          c"prototype".as_ptr().cast(),
+          &mut iterator_prototype,
+        )
+      },
+      "Get Iterator.prototype failed",
+    );
+
+    let mut object_constructor = ptr::null_mut();
+    check_status_or_throw!(
+      env,
+      unsafe {
+        sys::napi_get_named_property(
+          env,
+          global,
+          c"Object".as_ptr().cast(),
+          &mut object_constructor,
+        )
+      },
+      "Get global Object failed",
+    );
+    let mut object_create = ptr::null_mut();
+    check_status_or_throw!(
+      env,
+      unsafe {
+        sys::napi_get_named_property(
+          env,
+          object_constructor,
+          c"create".as_ptr().cast(),
+          &mut object_create,
+        )
+      },
+      "Get Object.create failed",
+    );
+
+    let args = [iterator_prototype];
+    let mut generator_object = ptr::null_mut();
+    check_status_or_throw!(
+      env,
+      unsafe {
+        sys::napi_call_function(
+          env,
+          object_constructor,
+          object_create,
+          args.len(),
+          args.as_ptr(),
+          &mut generator_object,
+        )
+      },
+      "Create Generator object with Iterator.prototype failed",
+    );
+    generator_object
+  } else {
+    let mut generator_object = ptr::null_mut();
+    check_status_or_throw!(
+      env,
+      unsafe { sys::napi_create_object(env, &mut generator_object) },
+      "Create Generator object failed",
+    );
+    generator_object
+  }
+}
