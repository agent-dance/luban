+test('should inherit native Iterator helpers when available', (t) => {
+  const IteratorConstructor = Reflect.get(globalThis, 'Iterator')
+  if (typeof IteratorConstructor !== 'function') {
+    t.pass()
+    return
+  }
+
+  const iterator = new Fib()[Symbol.iterator]()
+  t.is(Object.getPrototypeOf(iterator), IteratorConstructor.prototype)
+  t.true(iterator instanceof IteratorConstructor)
+  t.is(iterator[Symbol.iterator](), iterator)
+  t.is(typeof iterator.take, 'function')
+  t.deepEqual(Array.from(iterator.take(5)), [1, 1, 2, 3, 5])
+
+  const flatMapIterator = new Fib()[Symbol.iterator]()
+  const flatMapped = flatMapIterator
+    .flatMap((value) => [value, -value])
+    .take(4)
+  t.deepEqual(Array.from(flatMapped), [1, -1, 1, -1])
+})
