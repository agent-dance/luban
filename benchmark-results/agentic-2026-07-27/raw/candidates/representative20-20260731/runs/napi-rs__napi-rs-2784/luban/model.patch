+unsafe fn set_iterator_prototype(env: sys::napi_env, generator_object: sys::napi_value) {
+  let mut global = ptr::null_mut();
+  check_status_or_throw!(
+    env,
+    unsafe { sys::napi_get_global(env, &mut global) },
+    "Get global object failed",
+  );
+
+  let mut iterator_constructor = ptr::null_mut();
+  check_status_or_throw!(
+    env,
+    unsafe {
+      sys::napi_get_named_property(
+        env,
+        global,
+        c"Iterator".as_ptr().cast(),
+        &mut iterator_constructor,
+      )
+    },
+    "Get Iterator constructor failed",
+  );
+
+  let mut iterator_type = sys::ValueType::napi_undefined;
+  check_status_or_throw!(
+    env,
+    unsafe { sys::napi_typeof(env, iterator_constructor, &mut iterator_type) },
+    "Get Iterator constructor type failed",
+  );
+  // Iterator is only exposed as a global in runtimes that support iterator helpers.
+  // Keep the plain-object iterator used by older Node.js versions when it is absent.
+  if iterator_type != sys::ValueType::napi_function {
+    return;
+  }
+
+  let mut iterator_prototype = ptr::null_mut();
+  check_status_or_throw!(
+    env,
+    unsafe {
+      sys::napi_get_named_property(
+        env,
+        iterator_constructor,
+        c"prototype".as_ptr().cast(),
+        &mut iterator_prototype,
+      )
+    },
+    "Get Iterator prototype failed",
+  );
+  let mut prototype_type = sys::ValueType::napi_undefined;
+  check_status_or_throw!(
+    env,
+    unsafe { sys::napi_typeof(env, iterator_prototype, &mut prototype_type) },
+    "Get Iterator prototype type failed",
+  );
+  if prototype_type != sys::ValueType::napi_object {
+    return;
+  }
+
+  let mut object_constructor = ptr::null_mut();
+  check_status_or_throw!(
+    env,
+    unsafe {
+      sys::napi_get_named_property(
+        env,
+        global,
+        c"Object".as_ptr().cast(),
+        &mut object_constructor,
+      )
+    },
+    "Get Object constructor failed",
+  );
+  let mut set_prototype_of = ptr::null_mut();
+  check_status_or_throw!(
+    env,
+    unsafe {
+      sys::napi_get_named_property(
+        env,
+        object_constructor,
+        c"setPrototypeOf".as_ptr().cast(),
+        &mut set_prototype_of,
+      )
+    },
+    "Get Object.setPrototypeOf failed",
+  );
+
+  let args = [generator_object, iterator_prototype];
+  let mut result = ptr::null_mut();
+  check_status_or_throw!(
+    env,
+    unsafe {
+      sys::napi_call_function(
+        env,
+        object_constructor,
+        set_prototype_of,
+        args.len(),
+        args.as_ptr(),
+        &mut result,
+      )
+    },
+    "Set Generator object prototype failed",
+  );
+}
