+TEST("actor shells can quit from request error handlers") {
+  scoped_actor self{sys};
+  auto self_hdl = actor_cast<actor>(self);
+  auto cb = [self_hdl](app_t* app) {
+    app->self->mail(get_atom_v)
+      .request(self_hdl, 10ms)
+      .then(
+        [app](const std::string&) {
+          app->self->quit(sec::unexpected_response);
+        },
+        [app](const error& reason) { app->self->quit(reason); });
+  };
+  auto& mpx = sys.network_manager().mpx();
+  auto app = app_t::make(actor{self}, cb);
+  auto transport = net::octet_stream::transport::make(fd1, std::move(app));
+  auto mgr = net::socket_manager::make(&mpx, std::move(transport));
+  require(mpx.start(mgr));
+  fd1.id = net::invalid_socket_id;
+  actor hdl;
+  self->receive([&hdl](actor& x) { hdl = x; },
+                after(1s) >> [this] { fail("shell did not send its handle"); });
+  self->monitor(hdl);
+  self->receive(
+    [this](const down_msg& msg) {
+      check_eq(msg.reason, sec::request_timeout);
+    },
+    after(1s) >> [this] { fail("shell did not terminate after the timeout"); });
+}
