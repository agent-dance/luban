+/**
+ * Reads the latest custom state value from the current LangGraph thread.
+ * The selected value updates whenever LangChain emits a new state snapshot.
+ * Returns `defaultValue` (or `undefined`) until the key has a value.
+ *
+ * @example
+ * ```tsx
+ * const todos = useLangChainState<Todo[]>("todos", []);
+ * const files = useLangChainState<Record<string, string>>("files");
+ * ```
+ *
+ * @param key The custom LangGraph state key to read.
+ * @param defaultValue The value returned when the state key is undefined.
+ * @returns The current state value, or the provided fallback when undefined.
+ */
+export function useLangChainState<T>(key: string): T | undefined;
+export function useLangChainState<T>(key: string, defaultValue: T): T;
+export function useLangChainState<T>(
+  key: string,
+  defaultValue?: T,
+): T | undefined {
+  return useAuiState((s) => {
+    const extras = s.thread.extras;
+    if (!extras) return defaultValue;
+    const value = asLangChainRuntimeExtras(extras).values[key] as T | undefined;
+    return value === undefined ? defaultValue : value;
+  });
+}
