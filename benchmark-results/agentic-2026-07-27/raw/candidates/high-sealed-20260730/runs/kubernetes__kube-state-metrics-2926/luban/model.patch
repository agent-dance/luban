+func TestOptionsCustomResourceConfigFileYAML(t *testing.T) {
+	tests := []struct {
+		name string
+		yaml string
+		want string
+	}{
+		{
+			name: "established config option",
+			yaml: "custom_resource_config_file: /etc/kube-state-metrics/custom-resource-config.yaml\n",
+			want: "/etc/kube-state-metrics/custom-resource-config.yaml",
+		},
+		{
+			name: "v2.17 config option remains compatible",
+			yaml: "custom_resource_state_config_file: /etc/kube-state-metrics/v2.17-custom-resource-config.yaml\n",
+			want: "/etc/kube-state-metrics/v2.17-custom-resource-config.yaml",
+		},
+		{
+			name: "established option takes precedence",
+			yaml: "custom_resource_config_file: /established.yaml\ncustom_resource_state_config_file: /v2.17.yaml\n",
+			want: "/established.yaml",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			opts := NewOptions()
+			if err := yaml.Unmarshal([]byte(tt.yaml), opts); err != nil {
+				t.Fatalf("unmarshal options: %v", err)
+			}
+			if opts.CustomResourceConfigFile != tt.want {
+				t.Errorf("CustomResourceConfigFile = %q, want %q", opts.CustomResourceConfigFile, tt.want)
+			}
+		})
+	}
+}
