+// UnmarshalYAML preserves the established custom_resource_config_file option
+// while continuing to accept the custom_resource_state_config_file spelling
+// that was inadvertently introduced in v2.17.0.
+func (o *Options) UnmarshalYAML(node *yaml.Node) error {
+	type plainOptions Options
+	decoded := plainOptions(*o)
+	if err := node.Decode(&decoded); err != nil {
+		return err
+	}
+
+	var configFileNames struct {
+		CustomResourceConfigFile      *string `yaml:"custom_resource_config_file"`
+		CustomResourceStateConfigFile *string `yaml:"custom_resource_state_config_file"`
+	}
+	if err := node.Decode(&configFileNames); err != nil {
+		return err
+	}
+
+	*o = Options(decoded)
+	if configFileNames.CustomResourceConfigFile != nil {
+		o.CustomResourceConfigFile = *configFileNames.CustomResourceConfigFile
+	} else if configFileNames.CustomResourceStateConfigFile != nil {
+		o.CustomResourceConfigFile = *configFileNames.CustomResourceStateConfigFile
+	}
+	return nil
+}
