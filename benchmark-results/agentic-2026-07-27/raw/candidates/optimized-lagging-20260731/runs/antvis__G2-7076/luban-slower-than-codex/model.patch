@@ -0,0 +1,48 @@
+import { Chart } from '../../src';
+import { createNodeGCanvas } from './utils/createNodeGCanvas';
+import { createPromise, dispatchPlotEvent } from './utils/event';
+
+describe('chart.on series tooltip', () => {
+  const canvas = createNodeGCanvas(640, 480);
+
+  it('emits the currently selected x value', async () => {
+    const data = [
+      { date: '2025-01-01', value: 1 },
+      { date: '2025-01-02', value: 3 },
+      { date: '2025-01-03', value: 2 },
+      { date: '2025-01-04', value: 4 },
+      { date: '2025-01-05', value: 3 },
+    ];
+    const chart = new Chart({
+      canvas,
+      container: document.createElement('div'),
+    });
+    chart.options({
+      type: 'line',
+      data,
+      encode: { x: 'date', y: 'value' },
+      tooltip: { title: (d) => d.date },
+      interaction: { tooltip: { wait: 0 } },
+    });
+    await chart.render();
+
+    const [tooltipShowed, resolveShow] = createPromise();
+    chart.on('tooltip:show', (event) => {
+      if (!event.nativeEvent) return;
+      expect(event.data.title).toBe('2025-01-03');
+      expect(event.data.data.x).toBe('2025-01-03');
+      resolveShow();
+    });
+
+    dispatchPlotEvent(canvas, 'pointermove', {
+      offsetX: 320,
+      offsetY: 200,
+    });
+    await tooltipShowed;
+    chart.destroy();
+  });
+
+  afterAll(() => {
+    canvas?.destroy();
+  });
+});
