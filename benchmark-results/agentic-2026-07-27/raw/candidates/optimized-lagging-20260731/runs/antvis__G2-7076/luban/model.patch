+    chart.emit('tooltip:show', { data: { data: { x: dates[1] } } });
+    await sleep(80);
+
+    expect(selected.map((date) => date.getTime())).toEqual(
+      dates.map((date) => date.getTime()),
+    );
+    chart.destroy();
+  });
+
+  afterAll(() => {
+    canvas?.destroy();
+  });
