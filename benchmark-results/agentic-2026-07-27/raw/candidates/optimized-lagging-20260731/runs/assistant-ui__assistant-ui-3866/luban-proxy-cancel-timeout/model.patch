+export function useLangChainState<T>(
+  key: string,
+  defaultValue?: T,
+): T | undefined {
+  return useAuiState((s) => {
+    const extras = asLangChainRuntimeExtras(s.thread.extras);
+    const value = extras.values[key] as T | undefined;
+    return value === undefined ? defaultValue : value;
+  });
