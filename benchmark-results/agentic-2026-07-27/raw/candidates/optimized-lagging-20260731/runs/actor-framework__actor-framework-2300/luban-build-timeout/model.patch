+TEST("actor shells stop consuming messages after calling quit") {
+  scoped_actor self{sys};
+  auto& mpx = sys.network_manager().mpx();
+  auto app = app_t::make(actor{self}, [](app_t* app) {
+    auto* shell = app->self.get();
+    app->self->set_behavior([shell](int) { shell->quit(none); });
+  });
+  auto transport = net::octet_stream::transport::make(fd1, std::move(app));
+  auto mgr = net::socket_manager::make(&mpx, std::move(transport));
+  require(mpx.start(mgr));
+  fd1.id = net::invalid_socket_id;
+  actor hdl;
+  self->receive([&hdl](actor& x) { hdl = x; },
+                after(1s) >> [this] { fail("shell did not send its handle"); });
+  self->monitor(hdl);
+  anon_mail(42).send(hdl);
+  auto terminated = false;
+  self->receive([&terminated](const down_msg&) { terminated = true; },
+                after(1s) >> [] {});
+  check(terminated);
+}
