+#[cfg(all(test, feature = "cli"))]
+mod tests {
+    use clap::Parser;
+
+    use super::{BorderType, SkimOptions};
+
+    #[test]
+    fn border_none_is_accepted_and_disables_ui_borders() {
+        let options = SkimOptions::try_parse_from(["sk", "--border", "none"]).expect("--border none should parse");
+        assert!(matches!(options.border, Some(BorderType::None)));
