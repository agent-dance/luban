 	"testing"
 
 	"github.com/stretchr/testify/require"
@@ -30,3 +31,39 @@ func TestCrushIgnore(t *testing.T) {
 	require.False(t, dl.shouldIgnore("test1.txt", nil), ".txt files should not be ignored")
 	require.True(t, dl.shouldIgnore("test3.tmp", nil), ".tmp files should be ignored by common patterns")
 }
+
+func TestDotStarIgnoreDoesNotSkipTraversalRoot(t *testing.T) {
+	root := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(root, ".gitignore"), []byte(".*\n"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(root, ".hidden"), []byte("hidden"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(root, "example.txt"), []byte("test content"), 0o644))
+	require.NoError(t, os.Mkdir(filepath.Join(root, "nested"), 0o755))
+	require.NoError(t, os.WriteFile(filepath.Join(root, "nested", "another.go"), []byte("more content"), 0o644))
+
+	visibleFiles := []string{
+		filepath.Join(root, "example.txt"),
+		filepath.Join(root, "nested", "another.go"),
+	}
+	hiddenFiles := []string{
+		filepath.Join(root, ".gitignore"),
+		filepath.Join(root, ".hidden"),
+	}
+
+	listed, _, err := ListDirectory(root, nil, 0)
+	require.NoError(t, err)
+	for _, path := range visibleFiles {
+		require.Contains(t, listed, path)
+	}
+	for _, path := range hiddenFiles {
+		require.NotContains(t, listed, path)
+	}
+
+	matched, _, err := GlobWithDoubleStar("**/*", root, 0)
+	require.NoError(t, err)
+	for _, path := range visibleFiles {
+		require.Contains(t, matched, path)
+	}
+	for _, path := range hiddenFiles {
+		require.NotContains(t, matched, path)
+	}
+}
