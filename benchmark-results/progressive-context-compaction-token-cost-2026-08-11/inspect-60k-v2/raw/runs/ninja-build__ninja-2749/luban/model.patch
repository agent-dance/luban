   EXPECT_TRUE(builder_.AlreadyUpToDate());
 }
 
+TEST_F(BuildTest, DyndepBuildDiscoverOutputAfterDepfileInput) {
+  // Verify that an output discovered by dyndep is recognized as the producer
+  // of a depfile input even when the depfile input was visited first.
+  ASSERT_NO_FATAL_FAILURE(AssertParse(&state_,
+"rule touch\n"
+"  command = touch $out other\n"
+"rule cp\n"
+"  command = cp $in $out\n"
+"rule true\n"
+"  command = true\n"
+"build dd: cp dd-in\n"
+"build stamp: touch || dd\n"
+"  dyndep = dd\n"
+"build copy: true || stamp\n"
+"  depfile = copy.d\n"
+  ));
+  const char* ddf =
+"ninja_dyndep_version = 1\n"
+"build stamp | other: dyndep\n";
+  fs_.Create("dd-in", ddf);
+  fs_.Tick();
+  fs_.Create("dd", ddf);
+  fs_.Create("other", "");
+  fs_.Create("copy", "");
+  fs_.Create("copy.d", "copy: other\n");
+
+  string err;
+  EXPECT_TRUE(builder_.AddTarget("copy", &err));
+  ASSERT_EQ("", err);
+  EXPECT_EQ(builder_.Build(&err), ExitSuccess);
+  EXPECT_EQ("", err);
+  ASSERT_EQ(2u, command_runner_.commands_ran_.size());
+  EXPECT_EQ("touch stamp other", command_runner_.commands_ran_[0]);
+  EXPECT_EQ("true", command_runner_.commands_ran_[1]);
+}
