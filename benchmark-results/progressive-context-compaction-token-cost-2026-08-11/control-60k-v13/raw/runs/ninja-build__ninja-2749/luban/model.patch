+TEST_F(BuildTest, DyndepReadyOutputIsDepfileInput) {
+  // A depfile input may initially look like a source file, but then become a
+  // generated output when a later order-only input loads a ready dyndep file.
+  // If the producer is dirty, the depfile consumer must be dirty immediately.
+  ASSERT_NO_FATAL_FAILURE(AssertParse(&state_,
+"rule touch\n"
+"  command = touch $out other\n"
+"rule cp\n"
+"  command = cp $in $out\n"
+"build dd: cp dd-in\n"
+"build stamp: touch || dd\n"
+"  dyndep = dd\n"
+"build copy: cp source || stamp\n"
+"  depfile = copy.d\n"
+));
+  fs_.Create("dd-in", "");
+  fs_.Tick();
+  fs_.Create("dd",
+"ninja_dyndep_version = 1\n"
+"build stamp | other: dyndep\n"
+);
+  fs_.Create("source", "");
+  fs_.Create("other", "");
+  fs_.Tick();
+  fs_.Create("copy", "");
+  fs_.Create("copy.d", "copy: other\n");
+
+  string err;
+  EXPECT_TRUE(builder_.AddTarget("copy", &err));
+  ASSERT_EQ("", err);
+
+  EXPECT_EQ(builder_.Build(&err), ExitSuccess);
+  ASSERT_EQ("", err);
+  ASSERT_EQ(2u, command_runner_.commands_ran_.size());
+  EXPECT_EQ("touch stamp other", command_runner_.commands_ran_[0]);
+  EXPECT_EQ("cp source copy", command_runner_.commands_ran_[1]);
+}
