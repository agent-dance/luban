+TEST_F(BuildTest, DyndepLoadUpdatesEarlierDepfileInput) {
+  // Verify that loading a dyndep through a later order-only input updates the
+  // dirty state already computed for an earlier depfile input.
+  ASSERT_NO_FATAL_FAILURE(AssertParse(&state_,
+"rule touch\n"
+"  command = touch $out\n"
+"build stamp: touch trigger || dd\n"
+"  dyndep = dd\n"
+"build copy: touch || stamp\n"
+"  depfile = copy.d\n"
+));
+  fs_.Create("dd",
+"ninja_dyndep_version = 1\n"
+"build stamp | other: dyndep\n"
+);
+  fs_.Create("trigger", "");
+  fs_.Create("stamp", "");
+  fs_.Create("other", "");
+  fs_.Create("copy", "");
+  fs_.Create("copy.d", "copy: other\n");
+  fs_.Tick();
+  fs_.Create("trigger", "");
+
+  string err;
+  EXPECT_TRUE(builder_.AddTarget("copy", &err));
+  ASSERT_EQ("", err);
+  EXPECT_EQ(builder_.Build(&err), ExitSuccess);
+  EXPECT_EQ("", err);
+  EXPECT_EQ(std::vector<std::string>({"touch stamp", "touch copy"}),
+            command_runner_.commands_ran_);
+  EXPECT_TRUE(builder_.AlreadyUpToDate());
+}
