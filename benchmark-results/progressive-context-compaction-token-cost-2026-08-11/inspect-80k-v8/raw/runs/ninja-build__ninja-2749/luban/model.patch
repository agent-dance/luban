+TEST_F(BuildTest, DyndepBuildMakesEarlierDepfileInputDirty) {
+  // The depfile adds "other" before the order-only "stamp" input.  Loading
+  // stamp's dyndep file while visiting stamp then reveals that other is an
+  // output of the dirty stamp edge.  Verify that copy observes this change
+  // even though other was visited first.
+  ASSERT_NO_FATAL_FAILURE(AssertParse(&state_,
+"rule touch\n"
+"  command = touch $out\n"
+"rule generate-depfile\n"
+"  command = generate-depfile $out\n"
+"  depfile = $out.d\n"
+"build stamp: touch trigger || dd\n"
+"  dyndep = dd\n"
+"build copy: generate-depfile || stamp\n"
+"  test_dependency = other\n"
+  ));
+
+  fs_.Create("stamp", "");
+  fs_.Create("other", "");
+  fs_.Create("dd",
+"ninja_dyndep_version = 1\n"
+"build stamp | other: dyndep\n"
+  );
+  fs_.Tick();
+  fs_.Create("copy", "");
+  fs_.Create("copy.d", "copy: other\n");
+  fs_.Tick();
+  fs_.Create("trigger", "");
+
+  string err;
+  EXPECT_TRUE(builder_.AddTarget("copy", &err));
+  ASSERT_EQ("", err);
+  EXPECT_EQ(builder_.Build(&err), ExitSuccess);
+  EXPECT_EQ("", err);
+  EXPECT_EQ(std::vector<std::string>(
+                { "touch stamp other", "generate-depfile copy" }),
+            command_runner_.commands_ran_);
+}
