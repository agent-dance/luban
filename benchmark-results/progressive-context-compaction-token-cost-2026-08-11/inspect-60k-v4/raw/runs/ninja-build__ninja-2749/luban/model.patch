+TEST_F(BuildTest, DepfileDependencyOnDyndepOutput) {
+  ASSERT_NO_FATAL_FAILURE(AssertParse(&state_,
+"rule touch\n"
+"  command = touch $out\n"
+"rule cc\n"
+"  command = cc\n"
+"  depfile = $out.d\n"
+"build stamp: touch || stamp.dd\n"
+"  dyndep = stamp.dd\n"
+"build copy: cc || stamp\n"));
+
+  fs_.Create("stamp.dd",
+"ninja_dyndep_version = 1\n"
+"build stamp | other: dyndep\n");
+  fs_.Create("other", "");
+  fs_.Tick();
+  fs_.Create("copy", "");
+  fs_.Create("copy.d", "copy: other\n");
+
+  string err;
+  EXPECT_TRUE(builder_.AddTarget("copy", &err));
+  ASSERT_EQ("", err);
+  EXPECT_EQ(builder_.Build(&err), ExitSuccess);
+  EXPECT_EQ("", err);
+  EXPECT_EQ(std::vector<std::string>({ "touch stamp", "cc" }),
+            command_runner_.commands_ran_);
+}
