+TEST_F(BuildTest, DepfileDependencyOnDyndepOutput) {
+  // A depfile input may initially look like a source file, but a dyndep file
+  // loaded through an order-only input can reveal its producing edge.  Ensure
+  // that a dirty producer makes the depfile consumer dirty in the same scan.
+  ASSERT_NO_FATAL_FAILURE(AssertParse(&state_,
+"rule touch\n"
+"  command = touch $out\n"
+"rule cc\n"
+"  command = cc\n"
+"  depfile = $out.d\n"
+"build stamp: touch source || dd\n"
+"  dyndep = dd\n"
+"build copy: cc || stamp\n"
+));
+  fs_.Create("dd",
+"ninja_dyndep_version = 1\n"
+"build stamp | other: dyndep\n"
+);
+  fs_.Create("stamp", "");
+  fs_.Create("other", "");
+  fs_.Create("copy", "");
+  fs_.Create("copy.d", "copy: other\n");
+  fs_.Tick();
+  fs_.Create("source", "");
+
+  string err;
+  EXPECT_TRUE(builder_.AddTarget("copy", &err));
+  ASSERT_EQ("", err);
+  EXPECT_EQ(builder_.Build(&err), ExitSuccess);
+  EXPECT_EQ("", err);
+  ASSERT_EQ(2u, command_runner_.commands_ran_.size());
+  EXPECT_EQ("touch stamp", command_runner_.commands_ran_[0]);
+  EXPECT_EQ("cc", command_runner_.commands_ran_[1]);
+}
