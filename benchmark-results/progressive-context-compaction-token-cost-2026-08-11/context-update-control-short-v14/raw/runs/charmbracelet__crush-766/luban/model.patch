+
+func TestListDirectoryGitIgnoreDotStarDoesNotSkipRoot(t *testing.T) {
+	tempDir := t.TempDir()
+	oldWd, err := os.Getwd()
+	require.NoError(t, err)
+	require.NoError(t, os.Chdir(tempDir))
+	t.Cleanup(func() {
+		require.NoError(t, os.Chdir(oldWd))
+	})
+
+	require.NoError(t, os.WriteFile(".gitignore", []byte(".*\n"), 0o644))
+	require.NoError(t, os.WriteFile(".hidden", []byte("hidden"), 0o644))
+	require.NoError(t, os.WriteFile("example.txt", []byte("test content"), 0o644))
+	require.NoError(t, os.WriteFile("another.go", []byte("more content"), 0o644))
+
+	files, truncated, err := ListDirectory(".", nil, 0)
+	require.NoError(t, err)
+	require.False(t, truncated)
+	require.ElementsMatch(t, []string{"example.txt", "another.go"}, files)
+}
