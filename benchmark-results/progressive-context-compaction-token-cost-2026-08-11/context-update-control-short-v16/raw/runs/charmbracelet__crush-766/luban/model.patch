 // ShouldSkip checks if a path should be skipped based on gitignore, crushignore, and hidden file rules
 func (w *FastGlobWalker) ShouldSkip(path string) bool {
+	// Ignore patterns apply to entries below the traversal root, not the root
+	// itself. In particular, ".*" matches the root's relative path (".").
+	if filepath.Clean(path) == filepath.Clean(w.rootPath) {
+		return false
+	}
+
 	if SkipHidden(path) {
 		return true
 	}
