+
+func TestListDirectoryDotPatternDoesNotSkipRoot(t *testing.T) {
+	root := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(root, ".gitignore"), []byte(".*\n"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(root, ".hidden"), []byte("hidden"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(root, "example.txt"), []byte("test"), 0o644))
+	require.NoError(t, os.Mkdir(filepath.Join(root, "src"), 0o755))
+	require.NoError(t, os.WriteFile(filepath.Join(root, "src", "main.go"), []byte("package main"), 0o644))
+
+	files, truncated, err := ListDirectory(root, nil, 0)
+	require.NoError(t, err)
+	require.False(t, truncated)
+	require.Contains(t, files, filepath.Join(root, "example.txt"))
+	require.Contains(t, files, filepath.Join(root, "src", "main.go"))
+	require.NotContains(t, files, filepath.Join(root, ".gitignore"))
+	require.NotContains(t, files, filepath.Join(root, ".hidden"))
+}
+
+func TestGlobDotPatternDoesNotSkipRoot(t *testing.T) {
+	root := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(root, ".gitignore"), []byte(".*\n"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(root, ".hidden"), []byte("hidden"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(root, "example.txt"), []byte("test"), 0o644))
+
+	matches, truncated, err := GlobWithDoubleStar("**", root, 0)
+	require.NoError(t, err)
+	require.False(t, truncated)
+	require.Contains(t, matches, filepath.Join(root, "example.txt"))
+	require.NotContains(t, matches, filepath.Join(root, ".gitignore"))
+	require.NotContains(t, matches, filepath.Join(root, ".hidden"))
+}
