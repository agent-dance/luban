+TEST_F(BuildTest, DyndepReadyImplicitOutputDepfileInput) {
+  // Verify that loading a dyndep file while visiting a later order-only input
+  // updates the dirty state of an earlier input loaded from a depfile.
+  ASSERT_NO_FATAL_FAILURE(AssertParse(&state_,
+"rule touch_stamp\n"
+"  command = touch $out other\n"
+"rule touch_copy\n"
+"  command = touch $out\n"
+"  depfile = $out.d\n"
+"build stamp: touch_stamp in || dd\n"
+"  dyndep = dd\n"
+"build copy: touch_copy || stamp\n"
+  ));
+  fs_.Create("dd",
+"ninja_dyndep_version = 1\n"
+"build stamp | other: dyndep\n"
+  );
+  fs_.Create("stamp", "");
+  fs_.Create("other", "");
+  fs_.Tick();
+  fs_.Create("copy", "");
+  fs_.Create("copy.d", "copy: other\n");
+  fs_.Tick();
+  fs_.Create("in", "");
+
+  string err;
+  EXPECT_TRUE(builder_.AddTarget("copy", &err));
+  EXPECT_EQ("", err);
+
+  EXPECT_EQ(builder_.Build(&err), ExitSuccess);
+  EXPECT_EQ("", err);
+  ASSERT_EQ(2u, command_runner_.commands_ran_.size());
+  EXPECT_EQ("touch stamp other", command_runner_.commands_ran_[0]);
+  EXPECT_EQ("touch copy", command_runner_.commands_ran_[1]);
+}
