+TEST_F(BuildTest, DyndepReadyDiscoverOutputAndDepfileInput) {
+  // Verify that loading a ready dyndep file can make an earlier depfile input
+  // dirty.  The dependent edge must rebuild in the same invocation as the
+  // edge producing the newly-discovered output.
+  ASSERT_NO_FATAL_FAILURE(AssertParse(&state_,
+"rule touch\n"
+"  command = touch $out $out.imp\n"
+"rule touchdep\n"
+"  command = touch $out\n"
+"  depfile = $out.d\n"
+"build tmp: touch in || dd\n"
+"  dyndep = dd\n"
+"build out: touchdep || tmp\n"
+));
+  fs_.Create("dd",
+"ninja_dyndep_version = 1\n"
+"build tmp | tmp.imp: dyndep\n"
+);
+  fs_.Create("in", "");
+  fs_.Tick();
+  fs_.Create("tmp", "");
+  fs_.Create("tmp.imp", "");
+  fs_.Tick();
+  fs_.Create("out", "");
+  fs_.Create("out.d", "out: tmp.imp\n");
+  fs_.Tick();
+  fs_.Create("in", "changed");
+
+  string err;
+  EXPECT_TRUE(builder_.AddTarget("out", &err));
+  ASSERT_EQ("", err);
+
+  EXPECT_EQ(builder_.Build(&err), ExitSuccess);
+  EXPECT_EQ("", err);
+  ASSERT_EQ(2u, command_runner_.commands_ran_.size());
+  EXPECT_EQ("touch tmp tmp.imp", command_runner_.commands_ran_[0]);
+  EXPECT_EQ("touch out", command_runner_.commands_ran_[1]);
+  EXPECT_TRUE(builder_.AlreadyUpToDate());
+}
