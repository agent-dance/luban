+TEST_F(BuildTest, DepFileInputGeneratedByDyndep) {
+  ASSERT_NO_FATAL_FAILURE(AssertParse(&state_,
+"rule cc\n"
+"  command = cc $in -o $out\n"
+"  depfile = $out.d\n"
+"build stamp: cat || stamp.dd\n"
+"  dyndep = stamp.dd\n"
+"build copy: cc || stamp\n"));
+
+  // The depfile input is initially encountered as a source.  Loading the
+  // dyndep file through the later order-only input makes it an output of the
+  // dirty stamp edge.
+  fs_.Create("stamp.dd",
+             "ninja_dyndep_version = 1\n"
+             "build stamp | other: dyndep\n");
+  fs_.Create("other", "old");
+  fs_.Create("copy", "old");
+  fs_.Create("copy.d", "copy: other\n");
+
+  string err;
+  ASSERT_TRUE(builder_.AddTarget("copy", &err));
+  ASSERT_EQ("", err);
+  ASSERT_EQ(ExitSuccess, builder_.Build(&err));
+  ASSERT_EQ("", err);
+
+  EXPECT_EQ(std::vector<std::string>({
+                "cat  > stamp",
+                "cc  -o copy",
+            }),
+            command_runner_.commands_ran_);
+}
+
