+
+func TestDotStarIgnoreDoesNotSkipRoot(t *testing.T) {
+	tempDir := t.TempDir()
+
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, ".gitignore"), []byte(".*\nignored.txt\n"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, ".secret"), []byte("secret"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, "ignored.txt"), []byte("ignored"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, "example.txt"), []byte("example"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, "another.go"), []byte("package example"), 0o644))
+
+	files, truncated, err := ListDirectory(tempDir, nil, 0)
+	require.NoError(t, err)
+	require.False(t, truncated)
+	require.ElementsMatch(t, []string{
+		filepath.Join(tempDir, "example.txt"),
+		filepath.Join(tempDir, "another.go"),
+	}, files)
+
+	matches, truncated, err := GlobWithDoubleStar("*.txt", tempDir, 0)
+	require.NoError(t, err)
+	require.False(t, truncated)
+	require.Equal(t, []string{filepath.Join(tempDir, "example.txt")}, matches)
+}
