+TEST_F(GraphTest, DyndepOutputLoadedAfterDepfileDependency) {
+  AssertParse(&state_,
+"rule r\n"
+"  command = unused\n"
+"rule dep\n"
+"  command = unused\n"
+"  depfile = $out.d\n"
+"build stamp: r || dd\n"
+"  dyndep = dd\n"
+"build copy: dep || stamp\n"
+  );
+
+  // The depfile input is initially seen as a source file.  Loading the
+  // dyndep file while visiting the later order-only input makes it an output
+  // of the dirty stamp edge.
+  fs_.Create("other", "");
+  fs_.Tick();
+  fs_.Create("copy", "");
+  fs_.Create("copy.d", "copy: other\n");
+  fs_.Create("dd",
+"ninja_dyndep_version = 1\n"
+"build stamp | other: dyndep\n"
+  );
+
+  std::vector<Node*> validation_nodes;
+  string err;
+  EXPECT_TRUE(scan_.RecomputeDirty(GetNode("copy"), &validation_nodes, &err));
+  EXPECT_EQ("", err);
+  EXPECT_TRUE(GetNode("stamp")->dirty());
+  EXPECT_TRUE(GetNode("other")->dirty());
+  EXPECT_TRUE(GetNode("copy")->dirty());
+}
