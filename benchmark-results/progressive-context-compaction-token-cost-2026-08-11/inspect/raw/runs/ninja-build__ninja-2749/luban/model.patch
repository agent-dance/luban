+TEST_F(BuildTest, DyndepReadyDepfileInput) {
+  // Loading the depfile visits "other" before loading the dyndep file through
+  // the order-only input.  The dyndep file then makes "other" an output of the
+  // dirty stamp edge.  Verify that this new producer makes copy dirty now,
+  // rather than on the next build.
+  ASSERT_NO_FATAL_FAILURE(AssertParse(&state_,
+"rule touch\n"
+"  command = touch $out other\n"
+"rule cp\n"
+"  command = cp other $out\n"
+"  depfile = $out.d\n"
+"build stamp: touch || dd\n"
+"  dyndep = dd\n"
+"build copy: cp || stamp\n"
+));
+  fs_.Create("dd",
+"ninja_dyndep_version = 1\n"
+"build stamp | other: dyndep\n"
+);
+  fs_.Create("other", "old");
+  fs_.Create("copy.d", "copy: other\n");
+  fs_.Create("copy", "old");
+
+  string err;
+  EXPECT_TRUE(builder_.AddTarget("copy", &err));
+  ASSERT_EQ("", err);
+  EXPECT_EQ(builder_.Build(&err), ExitSuccess);
+  EXPECT_EQ("", err);
+  ASSERT_EQ(2u, command_runner_.commands_ran_.size());
+  EXPECT_EQ("touch stamp other", command_runner_.commands_ran_[0]);
+  EXPECT_EQ("cp other copy", command_runner_.commands_ran_[1]);
+}
