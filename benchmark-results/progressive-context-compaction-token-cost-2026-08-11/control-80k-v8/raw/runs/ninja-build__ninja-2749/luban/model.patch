+TEST_F(BuildTest, DyndepReadyDepfileInput) {
+  // A depfile input may initially look like a source file, then become a
+  // generated output when a later order-only input loads a dyndep file.
+  ASSERT_NO_FATAL_FAILURE(AssertParse(&state_,
+"rule touch\n"
+"  command = touch $out\n"
+"rule generate-depfile\n"
+"  command = generate-depfile $out\n"
+"  depfile = $out.d\n"
+"build stamp: touch trigger || dd\n"
+"  dyndep = dd\n"
+"build copy: generate-depfile || stamp\n"
+"  test_dependency = other\n"
+));
+  fs_.Create("dd",
+"ninja_dyndep_version = 1\n"
+"build stamp | other: dyndep\n"
+);
+  fs_.Create("stamp", "");
+  fs_.Create("other", "");
+  fs_.Tick();
+  fs_.Create("copy", "");
+  fs_.Create("copy.d", "copy: other\n");
+  fs_.Tick();
+  fs_.Create("trigger", "");
+
+  string err;
+  EXPECT_TRUE(builder_.AddTarget("copy", &err));
+  ASSERT_EQ("", err);
+  EXPECT_EQ(builder_.Build(&err), ExitSuccess);
+  EXPECT_EQ("", err);
+  ASSERT_EQ(2u, command_runner_.commands_ran_.size());
+  EXPECT_EQ("touch stamp other", command_runner_.commands_ran_[0]);
+  EXPECT_EQ("generate-depfile copy", command_runner_.commands_ran_[1]);
+}
