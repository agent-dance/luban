diff --git a/internal/fsext/ignore_test.go b/internal/fsext/ignore_test.go
index c2490a0..464b9be 100644
--- a/internal/fsext/ignore_test.go
+++ b/internal/fsext/ignore_test.go
@@ -2,6 +2,7 @@ package fsext
 
 import (
 	"os"
+	"path/filepath"
 	"testing"
 
 	"github.com/stretchr/testify/require"
@@ -30,3 +31,44 @@ func TestCrushIgnore(t *testing.T) {
 	require.False(t, dl.shouldIgnore("test1.txt", nil), ".txt files should not be ignored")
 	require.True(t, dl.shouldIgnore("test3.tmp", nil), ".tmp files should be ignored by common patterns")
 }
+
+func TestListDirectoryGitIgnoreDoesNotIgnoreRoot(t *testing.T) {
+	t.Parallel()
+
+	tempDir := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, ".gitignore"), []byte(".*\n"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, ".hidden"), []byte("hidden"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, "example.txt"), []byte("example"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, "another.go"), []byte("another"), 0o644))
+	require.NoError(t, os.Mkdir(filepath.Join(tempDir, "nested"), 0o755))
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, "nested", "visible.txt"), []byte("visible"), 0o644))
+
+	files, truncated, err := ListDirectory(tempDir, nil, 0)
+	require.NoError(t, err)
+	require.False(t, truncated)
+	require.ElementsMatch(t, []string{
+		filepath.Join(tempDir, "example.txt"),
+		filepath.Join(tempDir, "another.go"),
+		filepath.Join(tempDir, "nested") + string(filepath.Separator),
+		filepath.Join(tempDir, "nested", "visible.txt"),
+	}, files)
+}
+
+func TestGlobWithDoubleStarGitIgnoreDoesNotIgnoreRoot(t *testing.T) {
+	t.Parallel()
+
+	tempDir := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, ".gitignore"), []byte(".*\n"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, ".hidden.txt"), []byte("hidden"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, "example.txt"), []byte("example"), 0o644))
+	require.NoError(t, os.Mkdir(filepath.Join(tempDir, "nested"), 0o755))
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, "nested", "visible.txt"), []byte("visible"), 0o644))
+
+	files, truncated, err := GlobWithDoubleStar("**/*.txt", tempDir, 0)
+	require.NoError(t, err)
+	require.False(t, truncated)
+	require.ElementsMatch(t, []string{
+		filepath.Join(tempDir, "example.txt"),
+		filepath.Join(tempDir, "nested", "visible.txt"),
+	}, files)
+}
