--- a/src/build_test.cc
+++ b/src/build_test.cc
@@ -3793,6 +3793,38 @@ TEST_F(BuildTest, DyndepBuildDiscoverOutputAndDepfileInput) {
   EXPECT_TRUE(builder_.AlreadyUpToDate());
 }
 
+TEST_F(BuildTest, DyndepBuildDirtyOutputDiscoveredAsDepfileInput) {
+  // A depfile input may acquire an in-edge while a later order-only input is
+  // loading its dyndep file.  If that in-edge is dirty, the dependent must be
+  // made dirty during the same scan.
+  ASSERT_NO_FATAL_FAILURE(AssertParse(&state_,
+"rule touch\n"
+"  command = touch $out\n"
+"build stamp: touch || dd\n"
+"  dyndep = dd\n"
+"build copy: touch || stamp\n"
+"  depfile = copy.d\n"
+  ));
+  fs_.Create("dd",
+"ninja_dyndep_version = 1\n"
+"build stamp | other: dyndep\n"
+  );
+  fs_.Create("other", "");
+  fs_.Tick();
+  fs_.Create("copy", "");
+  fs_.Create("copy.d", "copy: other\n");
+
+  string err;
+  EXPECT_TRUE(builder_.AddTarget("copy", &err));
+  ASSERT_EQ("", err);
+
+  EXPECT_EQ(builder_.Build(&err), ExitSuccess);
+  EXPECT_EQ("", err);
+  ASSERT_EQ(2u, command_runner_.commands_ran_.size());
+  EXPECT_EQ("touch stamp other", command_runner_.commands_ran_[0]);
+  EXPECT_EQ("touch copy", command_runner_.commands_ran_[1]);
+}
