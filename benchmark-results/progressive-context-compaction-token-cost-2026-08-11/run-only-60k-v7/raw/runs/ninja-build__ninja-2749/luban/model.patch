+TEST_F(BuildTest, DyndepReadyDepfileInputDirty) {
+  // A later order-only input loads a dyndep file that makes an earlier
+  // depfile input an output of a dirty edge.  The dependent must become dirty
+  // in the same scan rather than waiting for the next Ninja invocation.
+  ASSERT_NO_FATAL_FAILURE(AssertParse(&state_,
+"rule touch\n"
+"  command = touch $out\n"
+"rule cc\n"
+"  command = cc $out\n"
+"  depfile = $out.d\n"
+"build stamp: touch trigger || dd\n"
+"  dyndep = dd\n"
+"build copy: cc || stamp\n"
+));
+  fs_.Create("stamp", "");
+  fs_.Create("other", "");
+  fs_.Create("copy", "");
+  fs_.Create("copy.d", "copy: other\n");
+  fs_.Create("dd",
+"ninja_dyndep_version = 1\n"
+"build stamp | other: dyndep\n"
+);
+  fs_.Tick();
+  fs_.Create("trigger", "");
+
+  string err;
+  EXPECT_TRUE(builder_.AddTarget("copy", &err));
+  ASSERT_EQ("", err);
+  EXPECT_EQ(builder_.Build(&err), ExitSuccess);
+  EXPECT_EQ("", err);
+  ASSERT_EQ(2u, command_runner_.commands_ran_.size());
+  EXPECT_EQ("touch stamp other", command_runner_.commands_ran_[0]);
+  EXPECT_EQ("cc copy", command_runner_.commands_ran_[1]);
+}
