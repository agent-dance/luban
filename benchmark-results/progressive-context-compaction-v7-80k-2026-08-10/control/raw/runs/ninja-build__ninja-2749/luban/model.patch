diff --git a/src/build_test.cc b/src/build_test.cc
index 5ba87fa..8175f3b 100644
--- a/src/build_test.cc
+++ b/src/build_test.cc
@@ -2061,6 +2061,37 @@ TEST_F(BuildDryRun, WithDyndep) {
   ASSERT_EQ(3u, command_runner_.commands_ran_.size());
 }
 
+TEST_F(BuildTest, DepfileDependencyOnDyndepOutput) {
+  ASSERT_NO_FATAL_FAILURE(AssertParse(&state_,
+"rule touch\n"
+"  command = touch $out\n"
+"rule generate-depfile\n"
+"  command = touch $out\n"
+"build stamp: touch producer.in || stamp.dd\n"
+"  dyndep = stamp.dd\n"
+"build copy: generate-depfile || stamp\n"
+"  test_dependency = other\n"
+"  depfile = copy.d\n"));
+  fs_.Create("stamp.dd",
+"ninja_dyndep_version = 1\n"
+"build stamp | other: dyndep\n");
+  fs_.Create("stamp", "");
+  fs_.Create("other", "");
+  fs_.Create("copy", "");
+  fs_.Create("copy.d", "copy: other\n");
+  fs_.Tick();
+  fs_.Create("producer.in", "");
+
+  string err;
+  EXPECT_TRUE(builder_.AddTarget("copy", &err));
+  ASSERT_EQ("", err);
+  EXPECT_EQ(builder_.Build(&err), ExitSuccess);
+  ASSERT_EQ("", err);
+  ASSERT_EQ(2u, command_runner_.commands_ran_.size());
+  EXPECT_EQ("touch stamp", command_runner_.commands_ran_[0]);
+  EXPECT_EQ("touch copy", command_runner_.commands_ran_[1]);
+}
+
 // Test that RSP files are created when & where appropriate and deleted after
 // successful execution.
 TEST_F(BuildTest, RspFileSuccess)
