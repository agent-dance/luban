+TEST_F(BuildTest, DyndepOutputUsedByDepfile) {
+  // Verify that an input loaded from a depfile is re-evaluated when loading a
+  // dyndep file makes it an output of another edge.
+  ASSERT_NO_FATAL_FAILURE(AssertParse(&state_,
+"rule touch\n"
+"  command = touch $out\n"
+"rule cc\n"
+"  command = cc $in\n"
+"  depfile = $out.d\n"
+"build dd: cp dd-in\n"
+"build stamp: touch stamp-in || dd\n"
+"  dyndep = dd\n"
+"build copy: cc || stamp\n"
+  ));
+
+  fs_.Create("stamp-in", "");
+  fs_.Create("dd-in", "");
+  fs_.Tick();
+  fs_.Create("dd",
+"ninja_dyndep_version = 1\n"
+"build stamp | other: dyndep\n"
+  );
+  fs_.Create("stamp", "");
+  fs_.Create("other", "");
+  fs_.Create("copy", "");
+  fs_.Create("copy.d", "copy: other\n");
+
+  // Make the stamp edge dirty.  The depfile-discovered input is visited
+  // before the order-only input whose dyndep file gives it an in-edge.
+  fs_.Tick();
+  fs_.Create("stamp-in", "");
+
+  string err;
+  EXPECT_TRUE(builder_.AddTarget("copy", &err));
+  EXPECT_EQ("", err);
+
+  EXPECT_EQ(builder_.Build(&err), ExitSuccess);
+  EXPECT_EQ("", err);
+  ASSERT_EQ(2u, command_runner_.commands_ran_.size());
+  EXPECT_EQ("touch stamp other", command_runner_.commands_ran_[0]);
+  EXPECT_EQ("cc ", command_runner_.commands_ran_[1]);
+}
