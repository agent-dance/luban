+// TestListDirectoryWithDotStarGitignore verifies that a `.*` gitignore pattern
+// only hides dotfiles and dot-directories, and does not cause the walk to skip
+// the root directory itself (which previously returned zero results).
+func TestListDirectoryWithDotStarGitignore(t *testing.T) {
+	tempDir := t.TempDir()
+
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, ".gitignore"), []byte(".*\n"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, "example.txt"), []byte("test"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, "another.go"), []byte("test"), 0o644))
+	require.NoError(t, os.MkdirAll(filepath.Join(tempDir, "subdir"), 0o755))
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, "subdir", "nested.txt"), []byte("test"), 0o644))
+	require.NoError(t, os.MkdirAll(filepath.Join(tempDir, ".hidden"), 0o755))
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, ".hidden", "secret.txt"), []byte("test"), 0o644))
+
+	files, truncated, err := ListDirectory(tempDir, nil, 0)
+	require.NoError(t, err)
+	require.False(t, truncated)
+
+	require.Contains(t, files, filepath.Join(tempDir, "example.txt"))
+	require.Contains(t, files, filepath.Join(tempDir, "another.go"))
+	require.Contains(t, files, filepath.Join(tempDir, "subdir"))
+	require.Contains(t, files, filepath.Join(tempDir, "subdir", "nested.txt"))
+	require.NotContains(t, files, filepath.Join(tempDir, ".gitignore"))
+	require.NotContains(t, files, filepath.Join(tempDir, ".hidden"))
+	require.NotContains(t, files, filepath.Join(tempDir, ".hidden", "secret.txt"))
+}
+
+// TestGlobWithDoubleStarDotStarGitignore verifies the same behavior for the
+// gitignore-aware glob walker.
+func TestGlobWithDoubleStarDotStarGitignore(t *testing.T) {
+	tempDir := t.TempDir()
+
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, ".gitignore"), []byte(".*\n"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, "example.txt"), []byte("test"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, "another.go"), []byte("test"), 0o644))
+
+	matches, truncated, err := GlobWithDoubleStar("**/*", tempDir, 0)
+	require.NoError(t, err)
+	require.False(t, truncated)
+
+	require.Contains(t, matches, filepath.Join(tempDir, "example.txt"))
+	require.Contains(t, matches, filepath.Join(tempDir, "another.go"))
+	require.NotContains(t, matches, filepath.Join(tempDir, ".gitignore"))
+}
