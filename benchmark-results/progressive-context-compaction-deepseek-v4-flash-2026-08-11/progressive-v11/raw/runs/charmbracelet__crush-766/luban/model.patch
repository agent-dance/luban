+
+func TestListDirectoryDotStarGitignore(t *testing.T) {
+	// Create a temporary directory for testing
+	tempDir := t.TempDir()
+
+	// Change to temp directory
+	oldWd, _ := os.Getwd()
+	err := os.Chdir(tempDir)
+	require.NoError(t, err)
+	defer os.Chdir(oldWd)
+
+	// A `.*` gitignore pattern must not prevent scanning the directory itself
+	require.NoError(t, os.WriteFile(".gitignore", []byte(".*\n"), 0o644))
+	require.NoError(t, os.WriteFile("example.txt", []byte("test content"), 0o644))
+	require.NoError(t, os.WriteFile("another.go", []byte("more content"), 0o644))
+
+	files, truncated, err := ListDirectory(".", nil, 0)
+	require.NoError(t, err)
+	require.False(t, truncated)
+	require.Contains(t, files, "example.txt")
+	require.Contains(t, files, "another.go")
+	require.NotContains(t, files, ".gitignore")
+}
+
+func TestGlobWithDoubleStarDotStarGitignore(t *testing.T) {
+	// Create a temporary directory for testing
+	tempDir := t.TempDir()
+
+	// Change to temp directory
+	oldWd, _ := os.Getwd()
+	err := os.Chdir(tempDir)
+	require.NoError(t, err)
+	defer os.Chdir(oldWd)
+
+	require.NoError(t, os.WriteFile(".gitignore", []byte(".*\n"), 0o644))
+	require.NoError(t, os.WriteFile("example.txt", []byte("test content"), 0o644))
+	require.NoError(t, os.WriteFile("another.go", []byte("more content"), 0o644))
+
+	files, _, err := GlobWithDoubleStar("**/*", ".", 0)
+	require.NoError(t, err)
+	require.Contains(t, files, "example.txt")
+	require.Contains(t, files, "another.go")
+	require.NotContains(t, files, ".gitignore")
+}
