+TEST_F(BuildTest, DyndepOutputDepfileDependency) {
+  // A depfile dependency may acquire a producing edge when a dyndep file is
+  // loaded while visiting a later order-only input.  Verify that the consumer
+  // observes the dependency's updated dirty state in the same build.
+  ASSERT_NO_FATAL_FAILURE(AssertParse(&state_,
+"rule touch\n"
+"  command = touch $out\n"
+"rule copy\n"
+"  command = cp other $out\n"
+"  depfile = $out.d\n"
+"build stamp: touch || dd\n"
+"  dyndep = dd\n"
+"build copy: copy || stamp\n"
+));
+  fs_.Create("dd",
+"ninja_dyndep_version = 1\n"
+"build stamp | other: dyndep\n"
+);
+  fs_.Create("other", "");
+  fs_.Tick();
+  fs_.Create("copy", "");
+  fs_.Create("copy.d", "copy: other\n");
+
+  string err;
+  EXPECT_TRUE(builder_.AddTarget("copy", &err));
+  ASSERT_EQ("", err);
+  EXPECT_EQ(builder_.Build(&err), ExitSuccess);
+  EXPECT_EQ("", err);
+  EXPECT_EQ(std::vector<std::string>({"touch stamp other", "cp other copy"}),
+            command_runner_.commands_ran_);
+}
+
