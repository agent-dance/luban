+
+func TestDotStarGitignoreDoesNotSkipRoot(t *testing.T) {
+	tempDir := t.TempDir()
+
+	// .* should ignore hidden entries but must never skip the walk root itself.
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, ".gitignore"), []byte(".*\n"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, "example.txt"), []byte("test"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, "another.go"), []byte("test"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, ".hidden"), []byte("test"), 0o644))
+
+	t.Run("ListDirectory", func(t *testing.T) {
+		files, _, err := ListDirectory(tempDir, nil, 0)
+		require.NoError(t, err)
+
+		got := make(map[string]bool, len(files))
+		for _, f := range files {
+			got[filepath.Base(f)] = true
+		}
+		require.Contains(t, got, "example.txt", "regular files must be listed despite .* gitignore")
+		require.Contains(t, got, "another.go", "regular files must be listed despite .* gitignore")
+		require.NotContains(t, got, ".hidden", "hidden files must still be ignored")
+	})
+
+	t.Run("GlobWithDoubleStar", func(t *testing.T) {
+		matches, _, err := GlobWithDoubleStar("*", tempDir, 0)
+		require.NoError(t, err)
+
+		got := make(map[string]bool, len(matches))
+		for _, m := range matches {
+			got[filepath.Base(m)] = true
+		}
+		require.Contains(t, got, "example.txt", "regular files must be found despite .* gitignore")
+		require.Contains(t, got, "another.go", "regular files must be found despite .* gitignore")
+	})
+}
