+
+func TestListDirectoryWithDotStarGitignore(t *testing.T) {
+	// Regression test: a ".*" gitignore pattern must not cause the directory
+	// scan to skip the root directory itself (which would return zero files).
+	tempDir := t.TempDir()
+
+	oldWd, _ := os.Getwd()
+	require.NoError(t, os.Chdir(tempDir))
+	defer os.Chdir(oldWd)
+
+	require.NoError(t, os.WriteFile(".gitignore", []byte(".*\n"), 0o644))
+	require.NoError(t, os.WriteFile("example.txt", []byte("test"), 0o644))
+	require.NoError(t, os.WriteFile("another.go", []byte("test"), 0o644))
+	require.NoError(t, os.WriteFile(".hidden", []byte("test"), 0o644))
+
+	files, _, err := ListDirectory(".", nil, 0)
+	require.NoError(t, err)
+	require.NotEmpty(t, files, "files should be listed despite .* gitignore pattern")
+	for _, f := range files {
+		require.NotEqual(t, ".hidden", filepath.Base(f), "hidden files should still be ignored")
+	}
+}
+
+func TestGlobWithDotStarGitignore(t *testing.T) {
+	// Regression test: a ".*" gitignore pattern must not cause the glob walk
+	// to skip the root directory itself.
+	tempDir := t.TempDir()
+
+	oldWd, _ := os.Getwd()
+	require.NoError(t, os.Chdir(tempDir))
+	defer os.Chdir(oldWd)
+
+	require.NoError(t, os.WriteFile(".gitignore", []byte(".*\n"), 0o644))
+	require.NoError(t, os.WriteFile("example.txt", []byte("test"), 0o644))
+	require.NoError(t, os.WriteFile(".hidden", []byte("test"), 0o644))
+
+	files, _, err := GlobWithDoubleStar("**/*", ".", 0)
+	require.NoError(t, err)
+	require.NotEmpty(t, files, "glob should find files despite .* gitignore pattern")
+	for _, f := range files {
+		require.NotEqual(t, ".hidden", filepath.Base(f), "hidden files should still be ignored")
+	}
+}
