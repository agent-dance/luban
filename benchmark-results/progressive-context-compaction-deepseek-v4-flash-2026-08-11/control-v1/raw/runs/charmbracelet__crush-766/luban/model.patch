+
+func TestGitIgnoreDotStar(t *testing.T) {
+	// A ".gitignore" containing ".*" must only ignore dotfiles, never the
+	// search root itself. Otherwise the root directory matches the pattern
+	// (its relative path is ".") and the whole traversal is skipped.
+	tempDir := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, ".gitignore"), []byte(".*\n"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, "example.txt"), []byte("test content"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, "another.go"), []byte("package main"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, ".hidden"), []byte("hidden"), 0o644))
+
+	// The root directory itself must never be treated as ignored.
+	dl := NewDirectoryLister(tempDir)
+	require.False(t, dl.shouldIgnore(tempDir, nil))
+
+	walker := NewFastGlobWalker(tempDir)
+	require.False(t, walker.ShouldSkip(tempDir))
+	require.True(t, walker.ShouldSkip(filepath.Join(tempDir, ".hidden")))
+	require.False(t, walker.ShouldSkip(filepath.Join(tempDir, "example.txt")))
+
+	// ListDirectory (used by "/" file completion) must return visible files.
+	files, _, err := ListDirectory(tempDir, nil, 0)
+	require.NoError(t, err)
+	require.ElementsMatch(t, []string{
+		filepath.Join(tempDir, "another.go"),
+		filepath.Join(tempDir, "example.txt"),
+	}, files)
+
+	// GlobWithDoubleStar (fallback for the glob tool) must also work.
+	matches, _, err := GlobWithDoubleStar("**/*", tempDir, 0)
+	require.NoError(t, err)
+	require.ElementsMatch(t, []string{
+		filepath.Join(tempDir, "another.go"),
+		filepath.Join(tempDir, "example.txt"),
+	}, matches)
+}
+
+func TestListDirectoryDotStarRelativeRoot(t *testing.T) {
+	// The "/" file completion passes "." as the search root.
+	tempDir := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, ".gitignore"), []byte(".*\n"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, "example.txt"), []byte("test content"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, "another.go"), []byte("package main"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(tempDir, ".hidden"), []byte("hidden"), 0o644))
+
+	oldWd, err := os.Getwd()
+	require.NoError(t, err)
+	require.NoError(t, os.Chdir(tempDir))
+	defer os.Chdir(oldWd)
+
+	files, _, err := ListDirectory(".", nil, 0)
+	require.NoError(t, err)
+
+	var got []string
+	for _, f := range files {
+		got = append(got, strings.TrimPrefix(filepath.Clean(f), "."+string(filepath.Separator)))
+	}
+	require.ElementsMatch(t, []string{"another.go", "example.txt"}, got)
+}
