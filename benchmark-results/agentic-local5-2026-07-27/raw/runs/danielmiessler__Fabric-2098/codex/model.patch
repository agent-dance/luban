+func TestSendStreamReadsDoneOnlySSE(t *testing.T) {
+	apiServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/responses" {
+			http.NotFound(w, r)
+			return
+		}
+
+		w.Header().Set("Content-Type", "text/event-stream")
+		fmt.Fprintf(w, "data: %s\n\n", marshalJSON(t, map[string]any{
+			"type": string(constant.ResponseOutputTextDone("").Default()),
+			"text": "done-only stream",
+		}))
+		fmt.Fprint(w, "data: [DONE]\n\n")
+	}))
+	defer apiServer.Close()
+
+	client := newConfiguredTestClient(t, apiServer.URL, "acct_stream_done", testJWT("acct_stream_done", time.Now().Add(time.Hour)))
+
+	updates := make(chan domain.StreamUpdate, 2)
+	if err := client.SendStream(context.Background(), []*chat.ChatCompletionMessage{
+		{Role: chat.ChatMessageRoleUser, Content: "Hello"},
+	}, &domain.ChatOptions{Model: "gpt-5.4"}, updates); err != nil {
+		t.Fatalf("SendStream() error = %v", err)
+	}
+
+	var builder strings.Builder
+	for update := range updates {
+		if update.Type == domain.StreamTypeContent {
+			builder.WriteString(update.Content)
+		}
+	}
+	if builder.String() != "done-only stream\n" {
+		t.Fatalf("streamed content = %q, want %q", builder.String(), "done-only stream\n")
+	}
+}
