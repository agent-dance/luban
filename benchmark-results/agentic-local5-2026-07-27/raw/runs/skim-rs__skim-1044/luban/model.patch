+#[cfg(all(test, feature = "cli"))]
+mod tests {
+    use clap::Parser;
+
+    use super::*;
+
+    #[test]
+    fn border_none_disables_all_borders() {
+        let spaced = ["sk", "--border", "none"];
+        let equals = ["sk", "--border=none"];
+
+        for args in [spaced.as_slice(), equals.as_slice()] {
+            let options = SkimOptions::try_parse_from(args)
+                .expect("--border none should parse")
+                .build();
+
+            assert!(options.border.is_none());
+            assert!(options.no_border);
+        }
+    }
