+TEST_F(BuildTest, DyndepReadyDepfileDependency) {
+  // A depfile input may be visited before a later order-only input loads a
+  // dyndep file and reveals that the depfile input is an output of a dirty
+  // edge.  Verify that the dependent is made dirty in the same build.
+  ASSERT_NO_FATAL_FAILURE(AssertParse(&state_,
+"rule touch\n"
+"  command = touch $out\n"
+"rule cp\n"
+"  command = cp $in $out\n"
+"  depfile = $out.d\n"
+"build stamp: touch input || stamp.dd\n"
+"  dyndep = stamp.dd\n"
+"build copy: cp || stamp\n"
+));
+  fs_.Create("stamp.dd",
+"ninja_dyndep_version = 1\n"
+"build stamp | other: dyndep\n"
+);
+  fs_.Create("stamp", "");
+  fs_.Create("other", "");
+  fs_.Create("copy", "");
+  fs_.Create("copy.d", "copy: other\n");
+  fs_.Tick();
+  fs_.Create("input", "");
+
+  string err;
+  EXPECT_TRUE(builder_.AddTarget("copy", &err));
+  ASSERT_EQ("", err);
+  EXPECT_EQ(builder_.Build(&err), ExitSuccess);
+  EXPECT_EQ("", err);
+  ASSERT_EQ(2u, command_runner_.commands_ran_.size());
+  EXPECT_EQ("touch stamp other", command_runner_.commands_ran_[0]);
+  EXPECT_EQ("cp other copy", command_runner_.commands_ran_[1]);
+}
