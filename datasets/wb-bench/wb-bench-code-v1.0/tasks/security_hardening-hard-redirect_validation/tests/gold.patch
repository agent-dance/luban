+def _has_dangerous_prefix(value):
+    probe = value.strip()
+    previous = None
+    while previous != probe:
+        previous = probe
+        probe = unquote(probe)
+    return (
+        "\r" in probe
+        or "\n" in probe
+        or "\\" in probe
+        or probe.startswith("//")
+        or probe.startswith("///")
+    )
 
 
