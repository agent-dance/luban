 from .path import target_path
 
 
@@ -7,11 +8,17 @@ def extract_members(base, members):
     written = []
     for member in members:
         path = target_path(base, member["name"])
-        if member.get("type") == "dir":
+        kind = member.get("type", "file")
+        if kind == "symlink":
+            target_path(base, member.get("target", ""))
+            raise UnsafeArchiveError("symlinks are not extracted")
