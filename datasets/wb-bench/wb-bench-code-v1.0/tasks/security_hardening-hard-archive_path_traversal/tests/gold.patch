             os.makedirs(path, exist_ok=True)
-        else:
+        elif kind == "file":
             os.makedirs(os.path.dirname(path), exist_ok=True)
             with open(path, "wb") as fh:
                 fh.write(member.get("data", b""))
+        else:
+            raise UnsafeArchiveError(f"unsupported member type {kind}")
