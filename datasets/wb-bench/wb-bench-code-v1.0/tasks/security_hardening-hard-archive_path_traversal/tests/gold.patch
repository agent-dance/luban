     return written
diff --git a/archive_like/path.py b/archive_like/path.py
index 90acf88..e6e4ee8 100644
--- a/archive_like/path.py
+++ b/archive_like/path.py
@@ -1,5 +1,24 @@
 import os
+from urllib.parse import unquote
+
+from .errors import UnsafeArchiveError
+
+
+def _normalize_name(name):
+    value = str(name).replace("\\", "/")
+    previous = None
+    while previous != value:
+        previous = value
+        value = unquote(value)
+    return value.replace("\\", "/")
 
 
 def target_path(base, name):
-    return os.path.abspath(os.path.join(base, name))
+    base_real = os.path.realpath(os.path.abspath(base))
+    cleaned = _normalize_name(name)
+    if cleaned.startswith("/") or cleaned.startswith("../") or "/../" in f"/{cleaned}":
+        raise UnsafeArchiveError("archive member escapes base")
+    path = os.path.realpath(os.path.abspath(os.path.join(base_real, cleaned)))
+    if os.path.commonpath([base_real, path]) != base_real:
+        raise UnsafeArchiveError("archive member escapes base")
+    return path
