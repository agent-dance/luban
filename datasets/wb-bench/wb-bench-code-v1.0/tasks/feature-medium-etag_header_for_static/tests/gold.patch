@@ -0,0 +1,14 @@
+"""Utilities for static file serving with ETag support."""
+import hashlib
+from pathlib import Path
+
+
+def calculate_etag(file_path: Path) -> str:
+    """Calculate a strong ETag for a static file based on its content hash.
+
+    Uses SHA-256 truncated to 16 hex chars for a compact but
+    collision-resistant identifier.
+    """
+    content = file_path.read_bytes()
+    digest = hashlib.sha256(content).hexdigest()[:16]
+    return f'"{digest}"'
