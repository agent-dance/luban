+"""Relevance scoring for validation errors used by :func:`best_match`."""
+
+# Validation keywords that only need to match once and are therefore
+# deprioritized so a more specific sibling error wins when one exists.
+WEAK_MATCHES = ("anyOf", "oneOf")
+
+
+def relevance_key(error):
+    """Return a sort key scoring a validation error for ``best_match``.
+
+    Shallower errors win at the top level, while among equally-deep sibling
+    errors the one from the earliest instance location is preferred. This keeps
+    ``best_match`` stable regardless of the order in which errors are produced.
+
+    Returns a tuple suitable for use as a ``sorted``/``max`` key.
+    """
+    validator = error.validator
+    return (
+        -len(error.absolute_path),  # 'deeper' errors are more specific
+        error.absolute_path,        # earlier siblings win ties
+        validator not in WEAK_MATCHES,  # prefer non-weak keywords
+    )
