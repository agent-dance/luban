+def rows(p):
+    with p.open(newline='',encoding='utf-8') as f: return list(csv.DictReader(f))
+def build_report(data_dir: Path):
+    exp={r['user_id']:{'variant':r['variant'],'ts':datetime.fromisoformat(r['exposed_at'])} for r in rows(data_dir/'exposures.csv')}
+    purchases=defaultdict(list)
+    for e in rows(data_dir/'events.csv'):
+        if e['event']=='purchase': purchases[e['user_id']].append((datetime.fromisoformat(e['ts']), int(e['amount_cents'])))
+    variants=defaultdict(lambda:{'users':0,'buyers':0,'revenue_cents':0})
+    for uid,e in exp.items():
+        v=variants[e['variant']]; v['users']+=1; bought=False
+        for ts,amt in purchases.get(uid,[]):
+            if e['ts'] <= ts <= e['ts']+timedelta(days=7): bought=True; v['revenue_cents']+=amt
+        if bought: v['buyers']+=1
+    out=[]
+    for name,v in sorted(variants.items()):
+        out.append({'variant':name,'users':v['users'],'buyers':v['buyers'],'conversion_rate':round(v['buyers']/v['users'],4),'revenue_cents':v['revenue_cents'],'arpu_cents':round(v['revenue_cents']/v['users'],2)})
+    by={r['variant']:r for r in out}; lift=round(by['treatment']['conversion_rate']-by['control']['conversion_rate'],4)
+    return {'variants':out,'winner':'treatment' if lift>0 else 'control','conversion_lift':lift}
