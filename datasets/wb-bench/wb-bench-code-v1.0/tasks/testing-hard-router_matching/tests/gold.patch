+import unittest
+from werkzeug_like.router import MethodNotAllowed, NotFound, Redirect, Router
+
+
+class RouterMatchingRegressionTests(unittest.TestCase):
+    def test_int_converter_returns_int(self):
+        router = Router()
+        router.add("/users/<int:id>", "user")
+        self.assertEqual(router.match("/users/42"), ("user", {"id":42}))
+
+    def test_int_converter_accepts_leading_zero_as_int(self):
+        router = Router()
+        router.add("/users/<int:id>", "user")
+        self.assertEqual(router.match("/users/007"), ("user", {"id":7}))
+
+    def test_int_converter_rejects_non_digits(self):
+        router = Router()
+        router.add("/users/<int:id>", "user")
+        self.assertRaises(NotFound, router.match, "/users/abc")
+
+    def test_int_converter_rejects_negative_number(self):
+        router = Router()
+        router.add("/users/<int:id>", "user")
+        self.assertRaises(NotFound, router.match, "/users/-1")
+
+    def test_string_converter_captures_one_segment(self):
+        router = Router()
+        router.add("/users/<name>", "user")
+        self.assertEqual(router.match("/users/ada"), ("user", {"name":"ada"}))
+
+    def test_string_converter_does_not_capture_slash(self):
+        router = Router()
+        router.add("/users/<name>", "user")
+        self.assertRaises(NotFound, router.match, "/users/a/b")
+
+    def test_path_converter_captures_slashes(self):
+        router = Router()
+        router.add("/files/<path:name>", "file")
+        self.assertEqual(router.match("/files/a/b/c"), ("file", {"name":"a/b/c"}))
+
+    def test_path_converter_captures_single_segment(self):
+        router = Router()
+        router.add("/files/<path:name>", "file")
+        self.assertEqual(router.match("/files/readme.txt"), ("file", {"name":"readme.txt"}))
+
+    def test_path_converter_strips_trailing_empty_segment(self):
+        router = Router()
+        router.add("/files/<path:name>", "file")
+        self.assertEqual(router.match("/files/a/b/"), ("file", {"name":"a/b"}))
+
+    def test_method_mismatch_reports_allowed(self):
+        router = Router()
+        router.add("/items", "items", methods=("GET", "POST"))
+        with self.assertRaises(MethodNotAllowed) as ctx:
+            router.match("/items", method="DELETE")
+        self.assertEqual(ctx.exception.allowed, {"GET", "POST"})
+
+    def test_allowed_methods_union_across_matching_rules(self):
+        router = Router()
+        router.add("/items", "items_get", methods=("GET",))
+        router.add("/items", "items_post", methods=("POST",))
+        with self.assertRaises(MethodNotAllowed) as ctx:
+            router.match("/items", method="DELETE")
+        self.assertEqual(ctx.exception.allowed, {"GET", "POST"})
+
+    def test_strict_slash_redirects_to_slash(self):
+        router = Router()
+        router.add("/docs/", "docs")
+        with self.assertRaises(Redirect) as ctx:
+            router.match("/docs")
+        self.assertEqual(ctx.exception.target, "/docs/")
+
+    def test_strict_target_matches_after_redirect(self):
+        router = Router()
+        router.add("/docs/", "docs")
+        self.assertEqual(router.match("/docs/"), ("docs", {}))
+
+    def test_non_strict_slash_does_not_redirect(self):
+        router = Router()
+        router.add("/docs/", "docs", strict_slashes=False)
+        self.assertEqual(router.match("/docs"), ("docs", {}))
+
+    def test_static_route_can_win_before_dynamic(self):
+        router = Router()
+        router.add("/users/me", "me")
+        router.add("/users/<name>", "user")
+        self.assertEqual(router.match("/users/me"), ("me", {}))
+
+    def test_dynamic_route_wins_if_registered_first(self):
+        router = Router()
+        router.add("/users/<name>", "user")
+        router.add("/users/me", "me")
+        self.assertEqual(router.match("/users/me"), ("user", {"name":"me"}))
+
+    def test_missing_route_raises_not_found(self):
+        self.assertRaises(NotFound, Router().match, "/missing")
