<!doctype html>
<html lang="{{htmlLanguage}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{{.Meta.Title}}</title>
<style>
:root{--bg:#f4f6f8;--paper:#fff;--text:#15202b;--muted:#5d6975;--line:#d9e0e6;--accent:#075985;--accent-soft:#e0f2fe;--good:#166534;--good-soft:#dcfce7;--bad:#991b1b;--bad-soft:#fee2e2;--warn:#92400e;--warn-soft:#fef3c7;--diagnostic:#7c3aed;--pilot:#b45309;--formal:#047857;--mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;--sans:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}
@media(prefers-color-scheme:dark){:root{--bg:#0b1117;--paper:#111922;--text:#e5edf4;--muted:#9aa9b7;--line:#2a3947;--accent:#7dd3fc;--accent-soft:#123247;--good:#86efac;--good-soft:#12351f;--bad:#fca5a5;--bad-soft:#421b1b;--warn:#fcd34d;--warn-soft:#402f0d;--diagnostic:#c4b5fd;--pilot:#fbbf24;--formal:#6ee7b7}}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font:14px/1.55 var(--sans)}main{width:min(1480px,calc(100% - 32px));margin:24px auto 64px}.hero,.section,.experiment{background:var(--paper);border:1px solid var(--line);border-radius:14px;margin:0 0 18px;padding:24px;position:relative;overflow:hidden}.hero{padding:34px}.eyebrow{color:var(--accent);font-weight:700;letter-spacing:.08em;text-transform:uppercase}.hero h1{font-size:clamp(26px,4vw,48px);line-height:1.08;margin:8px 0 12px}.subtitle{color:var(--muted);font-size:16px;max-width:980px}.meta-line{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}.badge{display:inline-flex;align-items:center;border-radius:999px;padding:4px 10px;border:1px solid currentColor;font-weight:700;font-size:12px}.badge.formal{color:var(--formal)}.badge.pilot{color:var(--pilot)}.badge.diagnostic{color:var(--diagnostic)}.badge.unknown{color:var(--muted)}.watermark{position:absolute;right:-42px;top:34px;transform:rotate(28deg);padding:7px 58px;border:2px solid currentColor;color:var(--diagnostic);font-weight:800;letter-spacing:.08em;opacity:.55;pointer-events:none}h2{font-size:23px;margin:0 0 14px}h3{font-size:18px;margin:24px 0 10px}h4{font-size:15px;margin:18px 0 8px}.lead{font-size:16px}.muted,.note{color:var(--muted)}.note{font-size:12px}.callout{border-left:4px solid var(--accent);background:var(--accent-soft);padding:12px 14px;margin:12px 0}.callout.warn{border-color:var(--warn);background:var(--warn-soft)}.callout.bad{border-color:var(--bad);background:var(--bad-soft)}.callout.good{border-color:var(--good);background:var(--good-soft)}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}.stat{border-top:3px solid var(--line);padding:10px 0}.stat strong{display:block;font-size:20px}.table-wrap{overflow-x:auto;margin:10px 0 16px}table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}th,td{border-bottom:1px solid var(--line);text-align:left;padding:8px 9px;vertical-align:top}th{color:var(--muted);font-size:12px;letter-spacing:.02em}td.num,th.num{text-align:right;white-space:nowrap}.status{font-weight:700}.status.pass{color:var(--good)}.status.fail{color:var(--bad)}.status.unknown{color:var(--warn)}code,pre{font-family:var(--mono);font-size:12px}code{overflow-wrap:anywhere}pre{background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:12px;white-space:pre-wrap;word-break:break-word}.hash{font-family:var(--mono);font-size:11px;overflow-wrap:anywhere}.experiment-header{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap}.comparison-arrow{font-weight:800;color:var(--accent)}details{border-top:1px solid var(--line);padding:10px 0}summary{cursor:pointer;font-weight:700}.waterfall{width:100%;min-width:720px;height:auto;display:block}.wf-axis,.wf-grid{stroke:var(--line);stroke-width:1}.wf-label,.wf-value{fill:var(--muted);font:11px var(--mono)}.wf-header{fill:#0ea5e9}.wf-ttft{fill:#8b5cf6}.wf-stream{fill:#10b981}.wf-error{fill:#ef4444}.wf-tool{fill:#f59e0b}.legend{display:flex;flex-wrap:wrap;gap:12px;margin:8px 0;color:var(--muted);font-size:12px}.legend span::before{content:"";display:inline-block;width:10px;height:10px;margin-right:5px;border-radius:2px;background:var(--swatch)}.verdict{font-size:18px;font-weight:800}.criteria{display:flex;flex-wrap:wrap;gap:8px}.criterion{border:1px solid var(--line);border-radius:8px;padding:6px 9px}.criterion.pass{color:var(--good)}.criterion.fail{color:var(--bad)}.criterion.unknown{color:var(--warn)}footer{text-align:center;color:var(--muted);padding:24px}
@media(max-width:720px){main{width:min(100% - 16px,1480px);margin-top:8px}.hero,.section,.experiment{border-radius:10px;padding:16px}.hero{padding:20px}.watermark{font-size:11px;right:-58px}.grid{grid-template-columns:1fr}}
@media print{body{background:#fff;color:#111;font-size:10pt}main{width:100%;margin:0}.hero,.section,.experiment{border:1px solid #bbb;box-shadow:none;break-inside:auto;margin:0 0 10mm}.experiment{page-break-before:always}details>*{display:block!important}summary{list-style:none}.table-wrap{overflow:visible}.waterfall{min-width:0}.no-print{display:none!important}a{color:#111;text-decoration:none}a[href^="http"]::after{content:" (" attr(href) ")";font-size:8pt;overflow-wrap:anywhere}}
</style>
</head>
<body class="{{if .HasDiagnosticOnly}}diagnostic-only{{end}}">
<main>
<header class="hero">
  <div class="eyebrow">{{tr "agentic.report.eyebrow"}}</div>
  <h1>{{.Meta.Title}}</h1>
  <p class="subtitle">{{.Meta.Subtitle}}</p>
  <div class="meta-line">
    <span class="badge unknown">{{.Meta.Benchmark}} {{.Meta.BenchmarkVersion}}</span>
    <span class="badge unknown"><code>{{.Meta.BenchmarkContractID}}</code></span>
    <span class="badge unknown">{{tr "agentic.report.header.baseline"}} · {{.Meta.BaselineAgentID}}</span>
    <span class="badge unknown">{{tr "agentic.report.header.contender"}} · {{.Meta.ContenderAgentID}}</span>
    <span class="badge unknown">{{tr "agentic.report.header.evidence_as_of"}} · {{timeValue .Meta.AsOf}}</span>
  </div>
  {{if .DevelopmentContract}}<div class="watermark">{{tr "agentic.report.development.watermark"}}</div>{{else if .HasDiagnosticOnly}}<div class="watermark">{{tr "agentic.report.diagnostic.watermark"}}</div>{{end}}
  {{if .DevelopmentContract}}<div class="callout warn"><strong>{{tr "agentic.report.development.watermark"}}</strong></div>{{end}}
</header>

<section class="section" id="verdict">
  <h2>{{tr "agentic.report.section.verdict"}}</h2>
  <p class="verdict">{{verdictLabel .Verdict.Status}}</p>
  <p class="muted">{{tr "agentic.report.method.formal_only"}} {{tr "agentic.report.method.missing_not_zero"}}</p>
  <div class="criteria">{{range .Verdict.Criteria}}<span class="criterion {{criterionClass .Passed}}">{{metricLabel .Metric}} · {{criterionLabel .Passed}}</span>{{end}}</div>
</section>

<section class="section" id="method">
  <h2>{{tr "agentic.report.section.methodology"}}</h2>
  <div class="grid">
    <div class="stat"><span class="badge formal">{{tr "agentic.report.class.formal.label"}}</span><p>{{tr "agentic.report.class.formal.description"}}</p></div>
    <div class="stat"><span class="badge pilot">{{tr "agentic.report.class.pilot.label"}}</span><p>{{tr "agentic.report.class.pilot.description"}}</p></div>
    <div class="stat"><span class="badge diagnostic">{{tr "agentic.report.class.diagnostic.label"}}</span><p>{{tr "agentic.report.class.diagnostic.description"}}</p></div>
    <div class="stat"><span class="badge unknown">{{tr "agentic.report.class.public.label"}}</span><p>{{tr "agentic.report.class.public.description"}}</p></div>
  </div>
  <ul>
    <li>{{tr "agentic.report.method.same_model"}}</li><li>{{tr "agentic.report.method.same_tasks"}}</li>
    <li>{{tr "agentic.report.method.same_environment"}}</li><li>{{tr "agentic.report.method.paired_schedule"}}</li>
    <li>{{tr "agentic.report.method.independent_evaluation"}}</li><li>{{tr "agentic.report.method.metric_units"}}</li>
    <li>{{tr "agentic.report.method.missing_not_zero"}}</li><li>{{tr "agentic.report.method.gateway_evidence"}}</li>
    <li>{{tr "agentic.report.method.single_agent_fairness"}}</li>
    <li>{{tr "agentic.report.method.transport_accounting"}}</li>
    <li>{{tr "agentic.report.method.public_reference_cost"}}</li>
  </ul>
  <p class="note">{{tf "agentic.report.statistics.summary" .Statistics.Method (printf "%.0f%%" (mulNotAvailable .Statistics.ConfidenceLevel)) .Statistics.Resamples .Statistics.Seed}}</p>
</section>

<section class="section" id="public-reference">
  <h2>{{tr "agentic.report.section.public_reference"}}</h2>
  <div class="callout warn">{{tr "agentic.report.method.public_reference_cost"}}</div>
  {{if .PublicReferences}}
  <div class="table-wrap"><table>
    <thead><tr><th>{{tr "agentic.report.header.benchmark_version"}}</th><th>{{tr "agentic.report.header.model_contract"}}</th><th class="num">{{tr "agentic.report.header.score"}}</th><th class="num">{{tr "agentic.report.header.result"}}</th><th class="num"><code>cost/raw_attempt</code></th><th class="num"><code>trial_min/raw_attempt</code></th><th class="num"><code>agent_steps/raw_attempt</code></th><th class="num"><code>tokens/raw_attempt</code></th><th class="num">{{tr "agentic.report.header.cache_hit"}}</th><th>{{tr "agentic.report.reproduction.source"}}</th></tr></thead>
    <tbody>{{range .PublicReferences}}<tr>
      <td><strong>{{.Benchmark}}</strong><br><span class="muted">{{.Version}}</span>{{range .Components}}<br><span class="note">{{.Name}} · {{percentValue .Score}}</span>{{end}}</td>
      <td>{{.Agent}}<br><code>{{.Model}}</code><br><span class="muted">effort={{textOrMissing .ReasoningEffort}}</span></td>
      <td class="num">{{percentValue .Score}}</td><td class="num">{{if and .Passed .Total}}{{intValue .Passed}} / {{intValue .Total}}{{else}}{{tr "agentic.report.coverage.missing"}}{{end}}</td>
      <td class="num">{{costValue .CostPerTask}}</td><td class="num">{{floatValue .MinutesPerTask}}</td><td class="num">{{floatValue .TurnsPerTask}}</td><td class="num">{{floatValue .TokensPerTask}}</td><td class="num">{{percentValue .TokenWeightedCacheHit}}</td>
      <td><a href="{{.SourceURL}}" rel="noreferrer">{{tr "agentic.report.reproduction.source"}}</a><br>{{with .Computed}}<code>source_sha256={{.Provenance.SourceSHA256}}</code><br><code>projection_sha256={{.Provenance.ProjectionSHA256}}</code><br><code>config={{.Provenance.Configuration}}</code><br><code>raw/scored/excluded={{.RawRows}}/{{.ScoredRows}}/{{.ExcludedRows}}</code><br>{{end}}<span class="note">{{tr "agentic.report.header.evidence_as_of"}} · {{timeValue .AccessedAt}}<br>{{.Notes}}</span></td>
    </tr>{{end}}</tbody>
  </table></div>
  {{else}}<p class="muted">{{tr "agentic.report.empty.public_reference"}}</p>{{end}}
</section>

{{range .Experiments}}
<article class="experiment" id="experiment-{{.ID}}">{{$experiment := .}}
  <div class="experiment-header">
    <div><span class="badge {{classClass .Class}}">{{classLabel .Class}}</span><h2>{{.Label}}</h2><p>{{.Description}}</p></div>
    <code>{{.ID}}</code>
  </div>
  {{if eq .Class "diagnostic_canary"}}<div class="watermark">{{tr "agentic.report.diagnostic.watermark"}}</div><div class="callout warn">{{tr "agentic.report.class.diagnostic.description"}}<br>{{.SourceNote}}</div>{{end}}

  <h3>{{tr "agentic.report.section.experiment"}}</h3>
  <div class="table-wrap"><table><thead><tr><th>{{tr "agentic.report.header.category"}}</th><th>{{tr "agentic.report.header.status"}}</th><th>{{tr "agentic.report.header.evidence"}}</th></tr></thead><tbody>
    {{range .Gates}}<tr><td>{{gateLabel .Name}}</td><td class="status {{.Status}}">{{gateStatusLabel .Status}}</td><td><code>{{.Detail}}</code></td></tr>{{end}}
  </tbody></table></div>
  {{with .Manifest}}
  <div class="grid">
    <div class="stat"><code>dataset</code><strong>{{.DatasetName}}</strong><code>{{.DatasetCommit}}</code></div>
    <div class="stat"><code>evaluator</code><strong>{{.EvaluatorName}} {{.EvaluatorVersion}}</strong><code>{{.EvaluatorCommit}}</code></div>
    <div class="stat"><span>{{tr "agentic.report.header.task_universe"}}</span><strong>{{.ExpectedTasks}} × {{.Repetitions}}</strong><code>selection={{.SelectionMode}} · seed={{.PairingSeed}} · scoring={{.ScoringProfile}}</code></div>
    <div class="stat"><span>{{tr "agentic.report.header.resources"}}</span><strong>{{.CPUs}} CPU · {{.MemoryMB}} MB</strong><code>declared_storage={{.StorageMB}} MB · timeout={{.AgentTimeout}}s</code></div>
  </div>
  <div class="callout">{{tf "agentic.report.method.storage_declaration" .StorageMB}}<br><code>host.experiment_resume_min_bytes={{.HostStorageGuard.AdmissionMinimumAvailableBytes}}</code> · <code>host.warning_below_bytes={{.HostStorageGuard.RuntimeWarningBelowAvailableBytes}}</code> · <code>host.new_slot_and_runtime_floor_bytes={{.HostStorageGuard.RuntimeHardFloorAvailableBytes}}</code> · <code>host.poll_ms={{.HostStorageGuard.PollIntervalMS}}</code> · <code>host.max_completion_gap_ms={{.HostStorageGuard.MonitoringGapThresholdMS}}</code><br><code>host.preflight.stage={{.StoragePreflight.Stage}}</code> · <code>authority={{.StoragePreflight.Authority}}</code> · <code>passed={{.StoragePreflight.Passed}}</code> · <code>warning={{.StoragePreflight.Warning}}</code> · <code>observed_at={{timeValue .StoragePreflight.ObservedAt}}</code>{{range .StoragePreflight.Filesystems}}<br><code>host.preflight.fs[{{.Group}}].available_bytes={{.AvailableBytes}};total_bytes={{.TotalBytes}};roles={{.Roles}}</code>{{end}}<br><code>guest.configured_capacity_bytes=68719476736</code> · <code>guest.start_min_bytes={{.GuestStorageGuard.StartMinimumAvailableBytes}}</code> · <code>guest.runtime_abort_floor_bytes={{.GuestStorageGuard.RuntimeAbortBelowAvailableBytes}}</code> · <code>guest.poll_ms={{.GuestStorageGuard.PollIntervalMS}}</code> · <code>guest.max_completion_gap_ms={{.GuestStorageGuard.MonitoringGapThresholdMS}}</code></div>
  <div class="table-wrap"><table><thead><tr><th>{{tr "agentic.report.header.agent"}}</th><th>{{tr "agentic.report.header.model_contract"}}</th><th>{{tr "agentic.report.header.binary_sha"}}</th><th>{{tr "agentic.report.header.source_revision"}}</th><th>{{tr "agentic.report.header.workspace"}}</th></tr></thead><tbody>
    {{range .Agents}}<tr><td><strong>{{.ID}}</strong></td><td><code>{{.Provider}}/{{.Model}}/{{.ReasoningEffort}}</code><br><code>effective_service_tier={{.ServiceTier}}</code><br><code>request_encoding={{.ServiceTierRequestEncoding}}</code></td><td class="hash">{{.BinarySHA256}}</td><td class="hash">{{if .SourceBaseCommit}}base={{.SourceBaseCommit}}<br>tree={{.SourceTreeOID}}{{else}}{{tr "agentic.report.not_applicable"}}{{end}}</td><td class="hash">{{if .SourceArchiveSHA}}patch={{.SourcePatchSHA}}<br>archive={{.SourceArchiveSHA}}<br>receipt={{.BuildReceiptSHA}}<br><code>{{.BuildToolchain}}</code>{{else}}<code>binary-only</code>{{end}}</td></tr>{{end}}
  </tbody></table></div>

  {{range $experiment.Runs}}{{if .StorageAdmission.SchemaVersion}}
  <details><summary><code>execution_receipts</code> · {{.TaskID}} / {{.AgentID}} / rep={{.Repetition}}</summary>
    <p class="note"><code>cache.initial_state={{.CacheInitialState}}</code> · <code>cache.evidence_class={{.CacheEvidenceClass}}</code> · <code>policy_observed_requests={{intValue .Metrics.CachePolicyObservedRequests}}</code> · <code>key_present_requests={{intValue .Metrics.CacheKeyPresentRequests}}</code> · <code>per_run_unique_keys={{intValue .Metrics.CacheUniqueKeyCount}}</code> · <code>key_transitions={{intValue .Metrics.CacheKeyTransitions}}</code> · <code>lineage_stable={{if .Metrics.CacheLineageStable}}{{.Metrics.CacheLineageStable}}{{else}}{{tr "agentic.report.coverage.missing"}}{{end}}</code> · <code>request_hit_denominator=input_tokens_gte_1024_usage_receipts</code></p>
    <div class="table-wrap"><table><thead><tr><th><code>evidence</code></th><th><code>authority / status</code></th><th><code>guard / coverage</code></th><th><code>receipt identity</code></th></tr></thead><tbody>
      <tr><td><code>host.slot_admission</code></td><td><code>{{.StorageAdmission.Authority}} / passed={{.StorageAdmission.Passed}} / warning={{.StorageAdmission.Warning}}</code></td><td><code>stage={{.StorageAdmission.Stage}};declared_mb={{.StorageAdmission.DeclaredStorageMB}}</code>{{range .StorageAdmission.Filesystems}}<br><code>fs[{{.Group}}].available={{.AvailableBytes}};total={{.TotalBytes}};roles={{.Roles}}</code>{{end}}</td><td><code>observed_at={{timeValue .StorageAdmission.ObservedAt}}</code></td></tr>
      {{if .HostStorageEvidence.SchemaVersion}}<tr><td><code>host.runtime</code></td><td><code>{{.HostStorageEvidence.Receipt.Authority}} / {{.HostStorageEvidence.Receipt.Status}}</code></td><td>{{range .HostStorageEvidence.Receipt.Filesystems}}<code>fs[{{.Group}}].min_available={{.MinimumAvailableBytes}};max_used={{.MaximumUsedBytes}};samples={{.Samples}};max_gap_ms={{.MaximumCompletionGapMS}}</code><br>{{end}}</td><td class="hash"><code>path={{.HostStorageEvidence.ReceiptRelativePath}}</code><br><code>sha256={{.HostStorageEvidence.ReceiptSHA256}}</code></td></tr>{{end}}
      {{range .GuestStorageEvidence}}<tr><td><code>guest.{{.Receipt.Phase}}.runtime</code></td><td><code>{{.Receipt.Authority}} / {{.Receipt.Status}}</code></td><td><code>configured_capacity={{.Receipt.ConfiguredCapacityBytes}};declared_mb={{.Receipt.DeclaredStorageMB}}</code>{{range .Receipt.Filesystems}}<br><code>fs[{{.Group}}].min_available={{.MinimumAvailableBytes}};max_used={{.MaximumUsedBytes}};max_gap_ms={{.MaximumCompletionGapMS}}</code>{{end}}</td><td class="hash"><code>path={{.ReceiptRelativePath}}</code><br><code>sha256={{.ReceiptSHA256}}</code><br><code>session={{.Receipt.SessionIdentitySHA256}}</code><br><code>container={{.Receipt.ContainerIdentitySHA256}}</code></td></tr>{{end}}
      {{if .ServiceTierEvidence.SchemaVersion}}<tr><td><code>service_tier.client_canonicalization</code></td><td><code>representation={{textOrMissing .ServiceTierEvidence.Representation}}</code></td><td><code>transformed_rounds={{.ServiceTierEvidence.TransformedRoundCount}}</code><br><code>static_proof={{textOrMissing .ServiceTierEvidence.StaticProofSHA256}}</code><br><code>transformation_evidence={{textOrMissing .ServiceTierEvidence.TransformationEvidenceSHA256}}</code></td><td class="hash"><code>path={{textOrMissing .ServiceTierEvidence.ReceiptRelativePath}}</code><br><code>receipt_sha256={{textOrMissing .ServiceTierEvidence.ReceiptSHA256}}</code><br><code>final_binding={{textOrMissing .ServiceTierEvidence.BindingSHA256}}</code></td></tr>{{end}}
    </tbody></table></div>
    <p class="note"><code>host_storage_deltas=shared_host_diagnostic_only</code> · <code>service_tier_semantic_parity=true</code> · <code>request_json_byte_identical=not_claimed</code></p>
  </details>
  {{end}}{{end}}
  <p class="note"><strong>{{tr "agentic.report.header.network_policy"}}</strong> · task={{.TaskNetwork}} · verifier={{.VerifierNetwork}} · agent_to_controller_egress={{range $i,$v := .AgentEgressHosts}}{{if $i}}, {{end}}{{$v}}{{else}}none{{end}}<br><code>network_attestation={{.NetworkAttestation}}</code><br><code>egress_proxy_image={{.EgressProxyImage}}</code><br><code>egress_proxy_image_id={{.EgressProxyImageID}}</code><br><code>gateway_origin={{.ProviderOrigin}}</code> · <code>observation_authority={{.ProviderObservationAuthority}}</code> · <code>semantics_sha256={{.ProviderSemanticsSHA}}</code> · <code>tls_required={{.ProviderTLSRequired}}</code> · <code>websocket_allowed={{.ProviderWebSocketAllowed}}</code><br><strong>{{tr "agentic.report.header.pricing"}}</strong> · <code>catalog_equivalent=true</code> · <code>frozen_gateway_comparable_rate_card_estimate</code> · <code>source_basis=OpenAI_public_standard_rates</code> · {{.PricingCurrency}}/{{.PricingUnit}} tokens · <code>effective_at={{timeValue .PricingAt}}</code> · <code>observed_at={{timeValue .PricingObservedAt}}</code> · <a href="{{.PricingSource}}" rel="noreferrer"><code>model_and_pricing_catalog</code></a><br><code>actual_gateway_invoice=N/A_not_claimed</code> · <code>regional_data_residency_uplift=+10%</code> · <code>gateway_region=unknown</code><br><code>official_sources=</code><a href="https://developers.openai.com/api/docs/models/gpt-5.6-sol" rel="noreferrer"><code>model</code></a> · <a href="https://developers.openai.com/api/docs/guides/prompt-caching" rel="noreferrer"><code>prompt_cache</code></a> · <a href="https://openai.com/index/gpt-5-6/" rel="noreferrer"><code>ga_announcement</code></a></p>
  {{end}}

  {{with .PublicScorecard}}
  <h3><code>{{.Profile}}</code> · {{tr "agentic.report.section.aggregate_results"}}</h3>
  <div class="callout">{{tr "agentic.report.method.public_score_distinction"}}</div>
  <p class="note"><code>{{.SchemaVersion}}</code> · tasks={{.TaskCount}} · repetitions={{.Repetitions}}</p>
  <div class="table-wrap"><table><thead><tr><th>{{tr "agentic.report.header.agent"}}</th><th><code>raw / scored / excluded</code></th><th><code>failure_categories</code></th><th class="num"><code>live_pooled</code></th><th><code>exclusion_sensitivity</code></th><th class="num"><code>task_macro</code></th><th class="num"><code>pass@4</code></th><th><code>public_run_ci</code></th><th><code>run_samples</code></th></tr></thead><tbody>
    {{range .Agents}}<tr><td><strong>{{.AgentID}}</strong><br><span class="note">pass={{.Counts.Passed}} · fail={{.Counts.Failed}}</span></td><td>{{.Counts.Raw}} / {{.Counts.Scored}} / {{.Counts.Excluded}}</td><td><code>excluded={{publicFailureCounts .ExcludedByCategory}}</code><br><code>scored={{publicFailureCounts .ScoredFailuresByCategory}}</code></td><td class="num">{{publicRateValue .LivePooled}}</td><td><code>{{publicExclusionSensitivity .ExclusionSensitivity}}</code></td><td class="num">{{publicRateValue .TaskMacro}}</td><td class="num">{{publicPassAtKValue .PassAt4}}</td><td>{{publicFourRunValue .FourRunStatistics}}</td><td>{{publicRunSamples .FourRunStatistics}}</td></tr>{{end}}
  </tbody></table></div>
  <div class="table-wrap"><table><thead><tr><th>{{tr "agentic.report.header.agent"}}</th><th><code>all_executed</code></th><th>{{tr "agentic.report.metric.wall_time_seconds"}}</th><th>{{tr "agentic.report.metric.catalog_cost"}}</th><th><code>agent_steps</code></th><th>{{tr "agentic.report.metric.llm_calls_started"}} / rounds / errors</th><th>{{tr "agentic.report.metric.tool_invocations"}}</th><th>{{tr "agentic.report.metric.physical_operations"}}</th><th>{{tr "agentic.report.header.tokens"}}</th><th>{{tr "agentic.report.metric.token_weighted_cache_hit"}}</th></tr></thead><tbody>
    {{range .Agents}}<tr><td><strong>{{.AgentID}}</strong></td><td>{{.AllExecutedEfficiency.Attempts}}</td><td><code>agent</code> {{publicFloatAggregate .AllExecutedEfficiency.AgentDurationSeconds}}<br><code>trial</code> {{publicFloatAggregate .AllExecutedEfficiency.TrialDurationSeconds}}</td><td>{{publicCostAggregate .AllExecutedEfficiency.CostUSD}}</td><td>{{publicIntAggregate .AllExecutedEfficiency.AgentSteps}}</td><td><code>llm_calls_started</code> {{publicIntAggregate .AllExecutedEfficiency.ProviderRequests}}<br><code>successful_provider_rounds</code> {{publicIntAggregate .AllExecutedEfficiency.ProviderRounds}}<br><code>provider_errors</code> {{publicIntAggregate .AllExecutedEfficiency.ProviderErrors}}</td><td>{{publicIntAggregate .AllExecutedEfficiency.ToolInvocations}}</td><td>{{publicIntAggregate .AllExecutedEfficiency.PhysicalToolOperations}}</td><td><code>input</code> {{publicIntAggregate .AllExecutedEfficiency.InputTokens}}<br><code>cached</code> {{publicIntAggregate .AllExecutedEfficiency.CachedInputTokens}}<br><code>output</code> {{publicIntAggregate .AllExecutedEfficiency.OutputTokens}}</td><td>{{percentValue .AllExecutedEfficiency.TokenWeightedCacheRate}}</td></tr>{{end}}
  </tbody></table></div>
  {{with .Paired}}<h4><code>public_common_slot_pairing</code> · <code>{{.PairingMethod}}</code> · {{.ChallengerAgentID}} − {{.BaselineAgentID}}</h4><div class="table-wrap"><table><tbody>
    <tr><th><code>common_scored</code></th><td>{{.CommonScored}}</td><th><code>pass_rate_delta</code></th><td>{{relativeValue .PassRateDelta}}</td></tr>
    <tr><th><code>challenger_passed / baseline_passed</code></th><td>{{.ChallengerPassed}} / {{.BaselinePassed}}</td><th><code>both_pass / challenger_only / baseline_only / both_fail</code></th><td>{{.BothPass}} / {{.ChallengerOnly}} / {{.BaselineOnly}} / {{.BothFail}}</td></tr>
    <tr><th><code>McNemar b / c / discordant</code></th><td>{{.McNemar.BChallengerOnly}} / {{.McNemar.CBaselineOnly}} / {{.McNemar.Discordant}}</td><th><code>exact_two_sided_p</code></th><td>{{floatValue .McNemar.ExactTwoSidedP}}</td></tr>
  </tbody></table></div><details><summary><code>public_paired_rows</code> · {{len .Rows}}</summary><div class="table-wrap"><table><thead><tr><th>{{tr "agentic.report.header.task"}}</th><th><code>slot</code></th><th>{{.ChallengerAgentID}}</th><th>{{.BaselineAgentID}}</th></tr></thead><tbody>{{range .Rows}}<tr><td><code>{{.TaskID}}</code></td><td>{{.Slot}}</td><td>{{boolPassValue .ChallengerPassed}}</td><td>{{boolPassValue .BaselinePassed}}</td></tr>{{end}}</tbody></table></div></details>{{end}}
  {{with .ExclusionAnalysis.PairedImbalance}}<h4><code>paired_exclusion_imbalance</code> · {{.ChallengerAgentID}} − {{.BaselineAgentID}}</h4><div class="table-wrap"><table><tbody>
    <tr><th><code>raw_pairs / common_scored / any_excluded / both_excluded</code></th><td>{{.RawPairs}} / {{.CommonScored}} / {{.AnyExcluded}} / {{.BothExcluded}}</td><th><code>challenger_only / baseline_only / discordant</code></th><td>{{.ChallengerOnlyExcluded}} / {{.BaselineOnlyExcluded}} / {{.DiscordantExclusionSlots}}</td></tr>
    <tr><th><code>challenger / baseline excluded</code></th><td>{{.ChallengerExcluded}} / {{.BaselineExcluded}}</td><th><code>count_delta / absolute / rate_delta</code></th><td>{{.ChallengerMinusBaseline}} / {{.AbsoluteCountDifference}} / {{percentValue .ExclusionRateDelta}}</td></tr>
  </tbody></table></div><div class="table-wrap"><table><thead><tr><th><code>category</code></th><th class="num">{{.ChallengerAgentID}}</th><th class="num">{{.BaselineAgentID}}</th><th class="num"><code>delta / absolute</code></th></tr></thead><tbody>{{range .Categories}}<tr><td><code>{{.Category}}</code></td><td class="num">{{.ChallengerExcluded}}</td><td class="num">{{.BaselineExcluded}}</td><td class="num">{{.ChallengerMinusBaseline}} / {{.AbsoluteCountDifference}}</td></tr>{{end}}</tbody></table></div>{{end}}
  <details><summary><code>public_task_scores</code></summary>{{range .Agents}}<h4>{{.AgentID}}</h4><div class="table-wrap"><table><thead><tr><th>{{tr "agentic.report.header.task"}}</th><th><code>raw / scored / excluded / passed</code></th><th>{{tr "agentic.report.header.score"}}</th><th><code>excluded_attempts</code></th></tr></thead><tbody>{{range .Tasks}}<tr><td><code>{{.TaskID}}</code></td><td>{{.Raw}} / {{.Scored}} / {{.Excluded}} / {{.Passed}}</td><td>{{percentValue .Rate}}</td><td>{{range .ExcludedAttempts}}<code>{{.AttemptID}} · slot={{.Slot}} · {{.FailureCategory}} · {{timeValue .StartedAt}}</code><br>{{else}}{{tr "agentic.report.not_applicable"}}{{end}}</td></tr>{{end}}</tbody></table></div>{{end}}</details>
  {{end}}

  {{if .OrderStrata}}
  <h3>{{tr "agentic.report.section.execution_order"}}</h3>
  <div class="table-wrap"><table><thead><tr><th>{{tr "agentic.report.header.agent"}}</th><th><code>execution_position</code></th><th class="num"><code>raw / scored / excluded / passed</code></th><th class="num"><code>pass_rate</code></th><th class="num"><code>mean_trial_seconds</code></th><th class="num"><code>mean_same_gateway_comparable_cost</code></th></tr></thead><tbody>
    {{range .OrderStrata}}<tr><td><strong>{{.AgentID}}</strong></td><td><code>{{.Position}}</code></td><td class="num">{{.Raw}} / {{.Scored}} / {{.Excluded}} / {{.Passed}}</td><td class="num">{{percentValue .PassRate}}</td><td class="num">{{floatValue .MeanTrialSeconds}}<br><span class="note"><code>coverage={{.TrialObserved}}/{{.Raw}}</code></span></td><td class="num">{{costValue .MeanComparableCost}}<br><span class="note"><code>coverage={{.ComparableCostObserved}}/{{.Raw}}</code></span></td></tr>{{end}}
  </tbody></table></div>
  {{end}}

  <h3>{{tr "agentic.report.section.aggregate_results"}}</h3>
  {{if .PublicScorecard}}<div class="callout warn">{{tr "agentic.report.method.comparative_inference"}}</div>{{end}}
  <div class="table-wrap"><table>
    <thead><tr><th>{{tr "agentic.report.header.agent"}}</th><th class="num">{{tr "agentic.report.metric.pass_rate"}}</th><th>{{tr "agentic.report.header.confidence_interval"}}</th><th class="num">{{tr "agentic.report.metric.wall_time_seconds"}}</th><th class="num">{{tr "agentic.report.metric.llm_calls_started"}}</th><th class="num"><code>all_transport input / cached / uncached / cache_write / output</code></th><th class="num">{{tr "agentic.report.metric.token_weighted_cache_hit"}}</th><th class="num">{{tr "agentic.report.metric.catalog_cost"}}</th></tr></thead>
    <tbody>{{range .Agents}}<tr>
      <td><strong>{{.AgentID}}</strong><br><span class="muted">{{.Variant}} · tasks={{.Tasks}} · runs={{.Runs}}</span></td>
      <td class="num">{{passCountValue .Passed .Runs}}<br>{{percentValue .PassRate}}</td><td>{{passCIValue .PassCI}}</td>
      <td class="num"><code>agent</code> {{secondsValue .Metrics.WallTimeSeconds}}<br><code>trial</code> {{secondsValue .Metrics.TrialDurationSeconds}}</td><td class="num">{{intValue .Metrics.LLMCallsStarted}}<br><span class="note"><code>completed={{intValue .Metrics.CompletedLLMResponses}}</code> · <code>retry_amplification={{floatValue .Metrics.RetryAmplification}}</code> · <code>errors={{intValue .Metrics.ProviderErrors}}</code></span></td>
      <td class="num">{{int64Value .Metrics.AllExecutedInputTokens}} / {{int64Value .Metrics.AllExecutedCachedTokens}} / {{int64Value .Metrics.AllExecutedUncachedTokens}} / {{int64Value .Metrics.AllExecutedCacheWriteInputTokens}} / {{int64Value .Metrics.AllExecutedOutputTokens}}<br><span class="note"><code>ordinary_uncached=I-C-W</code> · <code>non_cached_base={{int64Value .Metrics.AllExecutedNonCachedBaseTokens}};definition=I-C;cache_write_included=true</code><br><code>usage={{coverageValue .Metrics.AllExecutedUsageObserved .Metrics.AllExecutedUsageTotal}}</code> · <code>cache_write={{coverageValue .Metrics.AllExecutedCacheWriteObserved .Metrics.AllExecutedCacheWriteTotal}}</code></span></td>
      <td class="num">{{percentValue .Metrics.AllExecutedCacheHit}}<br><span class="note"><code>eligible_request_hit={{percentValue .Metrics.RequestCacheHit}};n={{intValue .Metrics.RequestCacheObserved}}</code></span></td>
      <td class="num">{{headlineCostValue .Metrics}}<br><code>{{.Metrics.ComparableCostBasis}}</code><br><span class="note"><code>visible_all_transport_I/C/O;cache_write_premium_excluded</code></span></td>
    </tr>{{end}}</tbody>
  </table></div>

  <h3><code>transport_and_spend_audit</code></h3>
  <div class="callout">{{tr "agentic.report.method.transport_accounting"}}</div>
  <div class="table-wrap"><table>
    <thead><tr><th>{{tr "agentic.report.header.agent"}}</th><th class="num"><code>all_transport_attempts</code></th><th class="num"><code>prewarm attempts/errors</code></th><th class="num"><code>llm_calls_started_generate_true</code></th><th class="num"><code>http_sse / websocket inference</code></th><th class="num"><code>Σ per-run unique ws connections</code></th><th><code>all-transport cost coverage</code></th><th><code>all-executed tokens/cache</code></th><th><code>spend evidence</code></th></tr></thead>
    <tbody>{{range .Agents}}<tr><td><strong>{{.AgentID}}</strong></td><td class="num">{{intValue .Metrics.TransportAttempts}}</td><td class="num">{{intValue .Metrics.PrewarmAttempts}} / {{intValue .Metrics.PrewarmErrors}}<br><span class="note"><code>usage={{intValue .Metrics.PrewarmUsageObservations}}</code> · <code>unknown_cost={{intValue .Metrics.PrewarmUnknownCostAttempts}}</code></span></td><td class="num">{{intValue .Metrics.LLMCallsStarted}}<br><span class="note"><code>completed_responses={{intValue .Metrics.CompletedLLMResponses}}</code> · <code>retry_amplification={{floatValue .Metrics.RetryAmplification}}</code></span></td><td class="num">{{intValue .Metrics.HTTPInferenceRequests}} / {{intValue .Metrics.WebSocketInferenceRequests}}</td><td class="num">{{intValue .Metrics.WebSocketConnections}}</td><td><code>usage_receipts={{coverageValue .Metrics.AllExecutedUsageObserved .Metrics.AllExecutedUsageTotal}}</code><br><code>cost_receipts={{coverageValue .Metrics.CostReceiptObserved .Metrics.CostReceiptTotal}}</code><br><code>unknown_cost_attempts={{intValue .Metrics.UnknownCostAttempts}}</code><br><code>cost_identity_unknown={{intValue .Metrics.CostIdentityUnknownAttempts}}</code><br><code>cache_write={{coverageValue .Metrics.AllExecutedCacheWriteObserved .Metrics.AllExecutedCacheWriteTotal}}</code></td><td><code>input/cached/ordinary_uncached/cache_write/output={{int64Value .Metrics.AllExecutedInputTokens}}/{{int64Value .Metrics.AllExecutedCachedTokens}}/{{int64Value .Metrics.AllExecutedUncachedTokens}}/{{int64Value .Metrics.AllExecutedCacheWriteInputTokens}}/{{int64Value .Metrics.AllExecutedOutputTokens}}</code><br><code>non_cached_base={{int64Value .Metrics.AllExecutedNonCachedBaseTokens}};definition=I-C;cache_write_included=true</code><br><code>cache_hit={{percentValue .Metrics.AllExecutedCacheHit}}</code></td><td><code>headline={{headlineCostValue .Metrics}}</code> · <code>basis={{.Metrics.ComparableCostBasis}}</code> · <code>source_basis=OpenAI_public_standard_rates</code> · <code>visible_all_transport_I/C/O;cache_write_premium_excluded</code><br><code>frozen_rate_card_audit={{catalogCostValue .Metrics}}</code><br><code>provider_reported={{providerCostValue .Metrics}}</code><br><code>actual_gateway_invoice=N/A_not_claimed</code> · <code>regional_uplift_status=unknown</code></td></tr>{{end}}</tbody>
  </table></div>

  <h3>{{tr "agentic.report.section.task_results"}}</h3>
  <div class="table-wrap"><table><thead><tr><th>{{tr "agentic.report.header.task"}}</th><th>{{tr "agentic.report.header.agent"}}</th><th>{{tr "agentic.report.header.repetition"}}</th><th>{{tr "agentic.report.header.result"}}</th><th class="num">{{tr "agentic.report.metric.wall_time_seconds"}}</th><th class="num">{{tr "agentic.report.metric.llm_calls_started"}} / rounds / errors</th><th class="num">{{tr "agentic.report.metric.tool_bearing_rounds"}} / calls / physical</th><th class="num">{{tr "agentic.report.metric.tool_errors"}}</th><th class="num">{{tr "agentic.report.header.tokens"}}</th><th class="num">{{tr "agentic.report.header.cache_hit"}}</th><th class="num">{{tr "agentic.report.header.cost"}}</th></tr></thead><tbody>
    {{range .Runs}}<tr>
      <td><code>{{.TaskID}}</code></td><td>{{.AgentID}}<br><span class="note">{{.Variant}}</span></td><td>{{.Repetition}}</td><td class="status {{passClass .Passed}}">{{passValue .Passed}}</td>
      <td class="num"><code>agent</code> {{secondsValue .Metrics.WallTimeSeconds}}<br><code>trial</code> {{secondsValue .Metrics.TrialDurationSeconds}}<br><code>controller_recovered={{.ControllerRecovered}}</code></td><td class="num"><code>all_transport={{intValue .Metrics.TransportAttempts}}</code><br><code>llm_calls_started={{intValue .Metrics.LLMCallsStarted}}</code> / <code>completed_responses={{intValue .Metrics.CompletedLLMResponses}}</code> / <code>errors={{intValue .Metrics.ProviderErrors}}</code><br><code>retry_amplification={{floatValue .Metrics.RetryAmplification}}</code><br><span class="note"><code>lifecycle={{.ProviderAttemptState}}/{{.ProviderAttemptCount}}</code></span></td>
      <td class="num">{{intValue .Metrics.ToolBearingRounds}} / {{intValue .Metrics.ToolInvocations}} / {{intValue .Metrics.PhysicalToolOperations}}{{if .Metrics.NativeEvents}}<br><span class="note">{{tr "agentic.report.metric.native_events"}}={{intValue .Metrics.NativeEvents}}</span>{{end}}<br><span class="note"><code>execution_matched</code>={{intValue .Metrics.ToolTraceMatched}} · <code>unmatched</code>={{intValue .Metrics.ToolTraceUnmatched}} · <code>coverage</code>={{intValue .Metrics.ToolTraceMatched}}/{{intValue .Metrics.ToolInvocations}}<br>{{tr "agentic.report.metric.physical_operations"}}={{coverageValue .Metrics.PhysicalToolObserved .Metrics.PhysicalToolTotal}}</span></td>
      <td class="num">{{intValue .Metrics.ToolErrors}}<br><span class="note">{{tr "agentic.report.header.coverage"}} · {{coverageValue .Metrics.ToolErrorObserved .Metrics.ToolErrorTotal}}</span></td>
      <td class="num">{{int64Value .Metrics.AllExecutedInputTokens}} / {{int64Value .Metrics.AllExecutedCachedTokens}} / {{int64Value .Metrics.AllExecutedUncachedTokens}} / {{int64Value .Metrics.AllExecutedCacheWriteInputTokens}} / {{int64Value .Metrics.AllExecutedOutputTokens}}<br><span class="note"><code>ordinary_uncached=I-C-W</code> · <code>non_cached_base={{int64Value .Metrics.AllExecutedNonCachedBaseTokens}};definition=I-C;cache_write_included=true</code><br><code>usage={{coverageValue .Metrics.AllExecutedUsageObserved .Metrics.AllExecutedUsageTotal}}</code> · <code>cache_write={{coverageValue .Metrics.AllExecutedCacheWriteObserved .Metrics.AllExecutedCacheWriteTotal}}</code></span></td>
      <td class="num"><code>token_weighted={{percentValue .Metrics.AllExecutedCacheHit}}</code><br><code>eligible_request={{percentValue .Metrics.RequestCacheHit}}</code></td><td class="num"><code>estimate={{headlineCostValue .Metrics}}</code><br><code>basis={{.Metrics.ComparableCostBasis}}</code></td>
    </tr>{{end}}
  </tbody></table></div>

  {{range .Comparisons}}
  <h3>{{tr "agentic.report.header.paired_difference"}} · {{.Contender}} <span class="comparison-arrow">−</span> {{.Baseline}}</h3>
  <p>{{tf "agentic.report.paired.summary" .Tasks .Pairs .QualityWins .QualityLosses .QualityTies}} · <code>relative=ratio-of-sums</code></p>
  <div class="table-wrap"><table><thead><tr><th>{{tr "agentic.report.header.metric"}}</th><th class="num">{{.Baseline}} · {{tr "agentic.report.header.mean"}}</th><th class="num">{{.Contender}} · {{tr "agentic.report.header.mean"}}</th><th class="num">{{tr "agentic.report.header.paired_difference"}}</th><th class="num">{{tr "agentic.report.header.relative_change"}}</th><th>{{tr "agentic.report.header.confidence_interval"}}</th><th>{{tr "agentic.report.header.coverage"}}</th></tr></thead><tbody>
    {{range .Metrics}}<tr><td>{{metricLabel .Metric}}</td><td class="num">{{metricValue .Metric .Baseline}}</td><td class="num">{{metricValue .Metric .Contender}}</td><td class="num">{{metricValue .Metric .Difference}}</td><td class="num">{{relativeValue .RelativeChange}}</td><td>{{ciValue .CI .Metric}}</td><td>tasks={{.Tasks}} · pairs={{.Pairs}}{{if .Note}}<br>{{.Note}}{{end}}</td></tr>{{end}}
  </tbody></table></div>
  {{end}}

  <h3>{{tr "agentic.report.section.tool_analysis"}}</h3>
  <div class="callout">{{tr "agentic.report.method.metric_units"}}<br>{{tr "agentic.report.method.physical_auxiliary"}}</div>
  {{if .ToolStats}}<div class="table-wrap"><table><thead><tr><th>{{tr "agentic.report.header.agent"}}</th><th>{{tr "agentic.report.header.category"}}</th><th class="num">{{tr "agentic.report.header.calls"}}</th><th class="num">{{tr "agentic.report.metric.tool_errors"}}</th><th class="num">{{tr "agentic.report.header.duration"}}</th><th>{{tr "agentic.report.header.coverage"}}</th></tr></thead><tbody>
    {{range .ToolStats}}<tr><td>{{.AgentID}}</td><td><code>{{.Name}}</code></td><td class="num">{{intValue .Calls}}</td><td class="num">{{intValue .Errors}}</td><td class="num">{{if .DurationMS}}{{int64Value .DurationMS}} ms{{else}}{{tr "agentic.report.coverage.missing"}}{{end}}</td><td>error={{coverageValue .ErrorKnown .ErrorTotal}} · duration={{coverageValue .TimingKnown .TimingTotal}}</td></tr>{{end}}
  </tbody></table></div>{{else}}<p class="muted">{{tr "agentic.report.empty.tool_stats"}}</p>{{end}}

  {{range .Runs}}{{if .Rounds}}
  <details><summary>{{tr "agentic.report.section.tool_waterfall"}} · {{.TaskID}} / {{.AgentID}} / rep={{.Repetition}} / all_transport_attempts={{len .Rounds}}</summary>
    {{$run := .}}
    <div class="legend"><span style="--swatch:#0ea5e9">{{tr "agentic.report.waterfall.headers_wait"}}</span><span style="--swatch:#8b5cf6">{{tr "agentic.report.waterfall.ttft"}}</span><span style="--swatch:#10b981">{{tr "agentic.report.waterfall.stream"}}</span><span style="--swatch:#f59e0b"><code>prewarm</code></span><span style="--swatch:#ef4444">{{tr "agentic.report.waterfall.provider_error"}}</span></div>
    <div class="table-wrap"><svg class="waterfall" viewBox="0 0 980 {{svgHeight .Rounds}}" role="img" aria-label="{{tr "agentic.report.section.tool_waterfall"}} · {{$run.TaskID}} · {{$run.AgentID}}">
      <title>{{$run.TaskID}} / {{$run.AgentID}} · {{tr "agentic.report.section.tool_waterfall"}}</title><desc>{{tr "agentic.report.waterfall.description"}}</desc>
      <line class="wf-axis" x1="112" y1="20" x2="958" y2="20"/><text class="wf-label" x="112" y="13">{{tr "agentic.report.waterfall.agent_start"}}</text><text class="wf-label" x="900" y="13">{{tr "agentic.report.waterfall.agent_finish"}}</text>
      {{range $i,$round := .Rounds}}{{$y := svgY $i}}<text class="wf-label" x="4" y="{{$y}}">R{{$round.Round}} {{$round.Outcome}}</text><line class="wf-grid" x1="112" y1="{{$y}}" x2="958" y2="{{$y}}"/>
        {{if eq $round.Outcome "success"}}
          <rect class="wf-header" x="{{svgX $run $round}}" y="{{$y}}" width="{{svgWidth $run (derefFloat $round.HeadersMS)}}" height="10"/>
          <rect class="wf-ttft" x="{{svgPhaseX $run $round (derefFloat $round.HeadersMS)}}" y="{{$y}}" width="{{svgWidth $run (derefFloat $round.FirstByteMS)}}" height="10"/>
          <rect class="wf-stream" x="{{svgPhaseX $run $round (sumFloat $round.HeadersMS $round.FirstByteMS)}}" y="{{$y}}" width="{{svgWidth $run (derefFloat $round.StreamMS)}}" height="10"/>
        {{else if eq $round.Outcome "prewarm"}}<rect class="wf-tool" x="{{svgX $run $round}}" y="{{$y}}" width="{{svgWidth $run $round.ProviderMS}}" height="10"/>
        {{else}}<rect class="wf-error" x="{{svgX $run $round}}" y="{{$y}}" width="{{svgWidth $run $round.ProviderMS}}" height="10"/>{{end}}
      {{end}}
    </svg></div>
    <div class="table-wrap"><table><thead><tr><th><code>round / transport</code></th><th><code>outcome / disposition</code></th><th><code>request/response identity hashes</code></th><th><code>request controls / served model</code></th><th><code>cache policy evidence</code></th><th class="num"><code>provider_ms</code></th><th class="num"><code>headers_ms / ttft_ms / stream_ms</code></th><th class="num"><code>tool_calls / physical_ops</code></th><th class="num"><code>critical / total / queue_ms</code></th><th class="num"><code>input / cached / cache_write / output</code></th><th class="num"><code>post_round_gap_ms</code></th></tr></thead><tbody>
      {{range .Rounds}}<tr><td><code>{{.Round}} · {{.Transport}} · {{.ProviderAttemptKind}}</code><br><span class="note">{{timeValue .StartedAt}} → {{timeValue .FinishedAt}}</span></td><td>{{.Outcome}}{{if .ErrorCode}} · <code>{{.ErrorCode}}</code>{{end}}<br><code>{{.TransportDisposition}}</code></td><td class="hash"><code>request={{textOrMissing .RequestIDHash}}</code><br><code>response={{textOrMissing .ResponseIDHash}}</code><br><code>original_body={{.OriginalRequestBodySHA256}}</code><br><code>forwarded_body={{.ForwardedRequestBodySHA256}}</code><br><code>original_canonical={{.OriginalRequestCanonicalSHA256}}</code><br><code>forwarded_canonical={{.ForwardedRequestCanonicalSHA256}}</code><br><code>without_tier={{.OriginalWithoutTierSHA256}}/{{.ForwardedWithoutTierSHA256}}</code></td><td><code>reasoning.mode={{.ReasoningModeCanonical}}</code>{{if .RequestedReasoningMode}} / <code>{{.RequestedReasoningMode}}</code>{{end}}<br><code>verbosity={{textOrMissing .RequestedTextVerbosity}}</code><br><code>max_output_tokens={{if .MaxOutputTokensSpecified}}{{int64Value .MaxOutputTokens}}{{else}}{{tr "agentic.report.coverage.missing"}}{{end}}</code><br><code>tier.request.raw={{textOrMissing .RequestedServiceTier}};present={{.RequestedServiceTierPresent}};canonical={{.RequestedServiceTierCanonical}};representation={{.RequestedServiceTierRepresentation}}</code><br><code>tier.original.present={{.OriginalServiceTierPresent}};value={{textOrMissing .OriginalServiceTier}}</code><br><code>tier.forwarded.present={{.ForwardedServiceTierPresent}};value={{textOrMissing .ForwardedServiceTier}};bytes={{.ForwardedRequestBytes}}</code><br><code>tier.transform={{.ServiceTierTransformation}};exact_diff={{.ServiceTierTransformationExactDiff}};proof={{.ServiceTierTransformationProofSHA256}}</code><br><code>tier.client_agent={{.ClientAgentID}};canonicalization_binding={{textOrMissing .ClientCanonicalizationProofSHA256}}</code><br><code>tier.response={{.ResponseServiceTier}}/{{.ResponseServiceTierCanonical}};comparable={{.ServiceTierComparable}}</code><br><code>model={{textOrMissing .ResponseCreatedModel}}/{{textOrMissing .ResponseModel}}</code></td><td><code>observed={{.CachePolicyObserved}};key_present={{.PromptCacheKeyPresent}};key_hash={{textOrMissing .PromptCacheKeyHash}}</code><br><code>options.present={{.PromptCacheOptionsPresent}};mode={{textOrMissing .PromptCacheOptionsMode}};ttl_seconds={{int64Value .PromptCacheTTLSeconds}}</code><br><code>retention.present={{.PromptCacheRetentionPresent}};value={{textOrMissing .PromptCacheRetention}}</code><br><code>breakpoints={{.CacheBreakpointCount}};position_hashes={{.CacheBreakpointPositionHashes}}</code></td><td class="num">{{printf "%.1f" .ProviderMS}}</td><td class="num">{{floatValue .HeadersMS}} / {{floatValue .FirstByteMS}} / {{floatValue .StreamMS}}</td><td class="num">{{.ToolCalls}} / {{intValue .PhysicalTools}}</td><td class="num">{{int64Value .ToolCriticalMS}} / {{int64Value .ToolTotalMS}} / {{int64Value .ToolQueueMS}}</td><td class="num">{{int64Value .InputTokens}} / {{int64Value .CachedInputTokens}} / {{int64Value .CacheWriteTokens}} / {{int64Value .OutputTokens}}</td><td class="num">{{floatValue .PostRoundGapMS}}</td></tr>{{end}}
    </tbody></table></div>
    <p class="note">{{tr "agentic.report.waterfall.overlapping_totals"}} {{tr "agentic.report.waterfall.no_fabrication"}}</p>
  </details>
  {{end}}{{end}}
</article>
{{end}}

<section class="section" id="optimizations">
  <h2>{{tr "agentic.report.section.optimizations"}}</h2>
  {{if .Optimizations}}{{range .Optimizations}}
  <article>
    <span class="badge {{classClass .Entry.EvidenceClass}}">{{classLabel .Entry.EvidenceClass}}</span><h3>{{.Entry.Title}}</h3>
    <p class="lead">{{.Entry.Summary}}</p>
    <div class="grid"><div><h4>{{tr "agentic.report.optimization.design_defect"}}</h4><p>{{.Entry.DesignDefect}}</p></div><div><h4>{{tr "agentic.report.optimization.mechanism"}}</h4><p>{{.Entry.Mechanism}}</p></div><div><h4>{{tr "agentic.report.optimization.value"}}</h4><p>{{.Entry.Value}}</p></div><div><h4>{{tr "agentic.report.optimization.risk"}}</h4><ul>{{range .Entry.Risks}}<li>{{.}}</li>{{end}}</ul></div></div>
    <p><strong>{{tr "agentic.report.optimization.attribution_scope"}}</strong> · <code>{{.Entry.AttributionScope}}</code><br><strong>{{tr "agentic.report.optimization.measurement_layer"}}</strong> · <code>{{.Entry.MeasurementLayer}}</code><br><strong>{{tr "agentic.report.optimization.evidence_grade"}}</strong> · <code>{{.Entry.EvidenceGrade}}</code></p>
    <div class="grid"><div><h4>{{tr "agentic.report.optimization.expected_effect"}}</h4><p>{{.Entry.ExpectedEffect}}</p></div><div><h4>{{tr "agentic.report.optimization.observed_effect"}}</h4><p>{{.Entry.ObservedEffect}}</p></div><div><h4>{{tr "agentic.report.optimization.confounders"}}</h4><ul>{{range .Entry.Confounders}}<li><code>{{.}}</code></li>{{else}}<li>{{tr "agentic.report.not_applicable"}}</li>{{end}}</ul></div></div>
    <p><strong>{{tr "agentic.report.optimization.before"}}</strong> · <code>{{.Entry.Before.ExperimentID}}/{{.Entry.Before.AgentID}}</code><br><strong>{{tr "agentic.report.optimization.after"}}</strong> · <code>{{.Entry.After.ExperimentID}}/{{.Entry.After.AgentID}}</code><br><strong>{{tr "agentic.report.optimization.ablation"}}</strong> · {{ablationLabel .Entry.Ablation.Status}}{{if .Entry.Ablation.Endpoint}} · <code>{{.Entry.Ablation.Endpoint.ExperimentID}}/{{.Entry.Ablation.Endpoint.AgentID}}</code>{{end}} · {{.Entry.Ablation.Note}}</p>
    <div class="table-wrap"><table><thead><tr><th>{{tr "agentic.report.header.metric"}}</th><th class="num">{{tr "agentic.report.optimization.before"}}</th><th class="num">{{tr "agentic.report.optimization.after"}}</th><th class="num">{{tr "agentic.report.header.paired_difference"}}</th><th class="num">{{tr "agentic.report.header.relative_change"}}</th><th>{{tr "agentic.report.header.confidence_interval"}} / {{tr "agentic.report.header.coverage"}}</th></tr></thead><tbody>
      {{range .Metrics}}<tr><td>{{metricLabel .Metric}}</td><td class="num">{{metricValue .Metric .Baseline}}</td><td class="num">{{metricValue .Metric .Contender}}</td><td class="num">{{metricValue .Metric .Difference}}</td><td class="num">{{relativeValue .RelativeChange}}</td><td>{{ciValue .CI .Metric}}{{if .Note}}<br>{{.Note}}{{end}}</td></tr>{{end}}
    </tbody></table></div>
    {{if .AblationMetrics}}<h4>{{ablationLabel .Entry.Ablation.Status}}</h4><div class="table-wrap"><table><thead><tr><th>{{tr "agentic.report.header.metric"}}</th><th class="num">{{tr "agentic.report.optimization.ablation"}}</th><th class="num">{{tr "agentic.report.optimization.after"}}</th><th class="num">{{tr "agentic.report.header.paired_difference"}}</th><th class="num">{{tr "agentic.report.header.relative_change"}}</th><th>{{tr "agentic.report.header.confidence_interval"}}</th></tr></thead><tbody>{{range .AblationMetrics}}<tr><td>{{metricLabel .Metric}}</td><td class="num">{{metricValue .Metric .Baseline}}</td><td class="num">{{metricValue .Metric .Contender}}</td><td class="num">{{metricValue .Metric .Difference}}</td><td class="num">{{relativeValue .RelativeChange}}</td><td>{{ciValue .CI .Metric}}</td></tr>{{end}}</tbody></table></div>{{end}}
    <details><summary>{{tr "agentic.report.optimization.implementation"}}</summary><ul>{{range .Entry.Implementation}}<li><code>{{.Path}}</code>{{if .SHA256}} · <span class="hash">{{.SHA256}}</span>{{end}} · {{.Summary}}</li>{{end}}</ul></details>
  </article>
  {{end}}{{else}}<p class="muted">{{tr "agentic.report.empty.optimizations"}}</p>{{end}}
</section>

<section class="section" id="failures">
  <h2>{{tr "agentic.report.section.failures"}}</h2>
  {{if .FailureSummary}}<div class="table-wrap"><table><thead><tr><th>experiment</th><th>{{tr "agentic.report.header.task"}} / {{tr "agentic.report.header.agent"}} / {{tr "agentic.report.header.repetition"}}</th><th>{{tr "agentic.report.header.category"}}</th><th>{{tr "agentic.report.header.summary"}}</th><th>{{tr "agentic.report.header.evidence"}}</th></tr></thead><tbody>
    {{range .FailureSummary}}<tr><td>{{.ExperimentID}}</td><td><code>{{.TaskID}}</code><br>{{.AgentID}} / {{.Repetition}}</td><td>{{failureLabel .Category}}</td><td>{{.Summary}}</td><td>{{range .Evidence}}<code>{{.}}</code><br>{{end}}</td></tr>{{end}}
  </tbody></table></div>{{else}}<p class="muted">{{tr "agentic.report.empty.failures"}}</p>{{end}}
</section>

<section class="section" id="reproducibility">
  <h2>{{tr "agentic.report.section.reproduction"}}</h2>
  {{range .Experiments}}{{if .Hashes}}<h3>{{.Label}}</h3><div class="table-wrap"><table><thead><tr><th>{{tr "agentic.report.reproduction.object"}}</th><th>{{tr "agentic.report.reproduction.identity"}}</th><th>{{tr "agentic.report.reproduction.source"}}</th></tr></thead><tbody>{{range .Hashes}}<tr><td>{{.Name}}</td><td class="hash">{{.Value}}</td><td><code>{{.Source}}</code></td></tr>{{end}}</tbody></table></div>{{end}}{{end}}
  {{if .Reproduction}}{{range .Reproduction}}<h4>{{.Label}}</h4><pre><code>{{.Command}}</code></pre>{{end}}{{else}}<p class="muted">{{tr "agentic.report.reproduction.missing_command"}}</p>{{end}}
  <p class="note">{{tr "agentic.report.reproduction.safety"}}</p>
</section>

<section class="section" id="limitations">
  <h2>{{tr "agentic.report.section.limitations"}}</h2>
  <ul>{{range .Limitations}}<li>{{.}}</li>{{end}}</ul>
  <div class="callout warn">{{tr "agentic.report.limitation.frozen_cost"}} {{tr "agentic.report.limitation.incompatible_evidence"}}</div>
</section>

<footer>{{tf "agentic.report.footer" (timeValue .Meta.AsOf)}}</footer>
</main>
</body>
</html>
