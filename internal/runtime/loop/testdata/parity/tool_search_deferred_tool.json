{
  "schema_version": "1",
  "id": "tool_search_deferred_tool",
  "title": "keeps deferred tools hidden until ToolSearch returns a tool reference",
  "status": "active",
  "updated_at": "2026-07-10",
  "source_tests": ["internal/runtime/loop/integration_test.go:TestIntegrationToolSearchLoadsDeferredToolsOnNextTurn"],
  "coverage_tags": ["tools.deferred_visibility", "tools.tool_search", "tools.tool_reference_blocks"],
  "parity_tasks": ["task_11", "task_12", "task_16"],
  "input": {
    "user_message": "load task tool",
    "max_turns": 10,
    "max_tokens": 1024
  },
  "tools": [
    {"name": "Read", "kind": "static", "content": "ok", "concurrent_safe": true},
    {"name": "ToolSearch", "kind": "tool_search", "content": "Loaded 1 tool(s) for \"select:TaskCreate\": TaskCreate.", "reference_tool": "TaskCreate"},
    {"name": "TaskCreate", "kind": "static", "content": "ok", "concurrent_safe": false}
  ],
  "turns": [
    {
      "events": [
        {"type": "message_start", "message": {"role": "assistant"}},
        {"type": "content_block_start", "index": 0, "content_block": {"type": "tool_use", "id": "tool_search_1", "name": "ToolSearch"}},
        {"type": "content_block_delta", "index": 0, "delta": {"type": "input_json_delta", "partial_json": "{\"query\":\"select:TaskCreate\"}"}},
        {"type": "content_block_stop", "index": 0},
        {"type": "message_delta", "stop_reason": "tool_use"},
        {"type": "message_stop"}
      ]
    },
    {
      "events": [
        {"type": "message_start", "message": {"role": "assistant"}},
        {"type": "content_block_start", "index": 0, "content_block": {"type": "text"}},
        {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "TaskCreate is now available"}},
        {"type": "content_block_stop", "index": 0},
        {"type": "message_delta", "stop_reason": "end_turn"},
        {"type": "message_stop"}
      ]
    }
  ],
  "expected": {
    "terminal_reason": "end_turn",
    "final_text": "TaskCreate is now available",
    "provider_call_count": 2,
    "events": [
      {"type": "tool_use", "tool_name": "ToolSearch"},
      {"type": "tool_result", "tool_result_contains": "Loaded 1 tool(s)"},
      {"type": "text", "text": "TaskCreate is now available"}
    ],
    "tool_visibility_turns": [
      {"turn": 0, "has": ["ToolSearch"], "missing": ["Read", "TaskCreate"]},
      {"turn": 1, "has": ["TaskCreate"], "missing": []}
    ]
  }
